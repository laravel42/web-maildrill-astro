{
  "name": "web-maildrill-astro",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Maildrill marketing website and campaign workspace (Astro + React islands)",
  "scripts": {
    "dev": "astro dev",
    "dev:workers": "pnpm --filter workers dev",
    "dev:all": "node scripts/dev-all.mjs",
    "start:all": "node scripts/start-all.mjs",
    "tunnel": "bash scripts/local-tunnel.sh",
    "db:migrate": "pnpm --filter workers db:migrate",
    "db:reset": "pnpm --filter workers db:reset",
    "db:seed": "pnpm --filter workers db:seed",
    "db:seed:gallery": "pnpm --filter workers db:seed:gallery",
    "db:seed:images": "pnpm --filter workers db:seed:images",
    "db:backfill:thumbs": "pnpm --filter workers db:backfill:thumbs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check && node scripts/typecheck.mjs && tsc -p packages/wa-template-studio --noEmit",
    "audit:apca": "node scripts/apca-audit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:all": "pnpm test && pnpm test:e2e && pnpm test:coverage",
    "sync:rates:login": "node scripts/sync-infobip-rates.mjs login",
    "sync:rates": "node scripts/sync-infobip-rates.mjs",
    "gen:api": "openapi-typescript src/lib/server/openapi.product.json -o src/lib/server/api.product.ts && openapi-typescript src/lib/server/openapi.messaging.json -o src/lib/server/api.messaging.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/node": "^11.0.0",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@auth/core": "^0.37.3",
    "astro": "^7.1.1",
    "auth-astro": "^4.2.0",
    "email-builder-standalone": "workspace:*",
    "infobip-rtc": "^2.7.36",
    "nodemailer": "^9.0.3",
    "openapi-fetch": "^0.17.0",
    "posthog-js": "^1.407.0",
    "posthog-node": "^5.46.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tslib": "^2.8.1",
    "wa-template-studio": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/set-cookie-parser": "^2.4.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.7.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065"
}
