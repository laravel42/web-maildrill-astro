{
  "name": "web-maildrill-astro",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Maildrill marketing website and campaign workspace (Astro + React islands)",
  "scripts": {
    "dev": "astro dev",
    "dev:workers": "pnpm --filter workers dev",
    "dev:all": "node scripts/dev-all.mjs",
    "start:all": "node scripts/start-all.mjs",
    "tunnel": "bash scripts/local-tunnel.sh",
    "db:migrate": "pnpm --filter workers db:migrate",
    "db:reset": "pnpm --filter workers db:reset",
    "db:seed": "pnpm --filter workers db:seed",
    "db:seed:gallery": "pnpm --filter workers db:seed:gallery",
    "db:seed:images": "pnpm --filter workers db:seed:images",
    "db:backfill:thumbs": "pnpm --filter workers db:backfill:thumbs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check && node scripts/typecheck.mjs && tsc -p packages/wa-template-studio --noEmit",
    "audit:apca": "node scripts/apca-audit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:all": "pnpm test && pnpm test:e2e && pnpm test:coverage",
    "sync:rates:login": "node scripts/sync-infobip-rates.mjs login",
    "sync:rates": "node scripts/sync-infobip-rates.mjs",
    "gen:api": "openapi-typescript src/lib/server/openapi.product.json -o src/lib/server/api.product.ts && openapi-typescript src/lib/server/openapi.messaging.json -o src/lib/server/api.messaging.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.0",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@auth/core": "^0.41.3",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@simplewebauthn/browser": "^13.3.0",
    "astro": "^7.2.0",
    "auth-astro": "^4.2.0",
    "email-builder-standalone": "workspace:*",
    "emoji-mart": "^5.6.0",
    "infobip-rtc": "^2.7.36",
    "nodemailer": "^9.0.5",
    "openapi-fetch": "^0.17.0",
    "posthog-js": "^1.414.0",
    "posthog-node": "^5.48.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tslib": "^2.8.1",
    "wa-template-studio": "workspace:*",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/set-cookie-parser": "^2.4.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.9.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
