###############################################################################
# Monorepo root .env.example — Astro site + workers/ backend
# Copy to `.env` at the repo root and fill in secrets. Never commit `.env`.
# workers/ loads this file automatically (see packages/config).
###############################################################################

# =============================================================================
# Astro site (web-maildrill-astro)
# =============================================================================

# Public site URL (canonicals, sitemap, OG)
PUBLIC_SITE_URL=https://maildrill.net

# Browser PostHog — use PUBLIC_POSTHOG_PROJECT_TOKEN (project write token `phc_…`).
# PUBLIC_POSTHOG_KEY is legacy/unused; leave empty.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
PUBLIC_POSTHOG_PROJECT_TOKEN=

# Auth.js session secret — openssl rand -base64 32
AUTH_SECRET=

# BFF → backends. Unified `pnpm --dir workers dev` serves everything on :3001,
# so leave the split URLs unset (they fall back to API_BASE_URL). Docker /
# Ploi split: product :3001, messaging :3002, email-builder :3003.
API_BASE_URL=http://localhost:3001
# MESSAGING_API_BASE_URL=http://localhost:3002
# EB_API_BASE_URL=http://localhost:3003

# Shared with workers/ — Astro mints tenant JWTs; product-api verifies them.
# Production must use a strong secret (not change-me*). openssl rand -base64 32
JWT_SECRET=change-me-in-production

# Account security (passkeys + TOTP 2FA) — read by workers/.
# SECURITY_ENCRYPTION_KEY encrypts TOTP secrets at rest (AES-256-GCM).
# 32 bytes: openssl rand -base64 32. Empty in dev derives a key from
# JWT_SECRET with a boot warning; PRODUCTION REQUIRES IT before anyone
# enables an authenticator (setup throws without it).
SECURITY_ENCRYPTION_KEY=
# WebAuthn relying party: the registrable domain the app is served on, and
# the exact origins allowed to complete ceremonies (comma-separated).
# Production: WEBAUTHN_RP_ID=maildrill.net / WEBAUTHN_ORIGINS=https://maildrill.net
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:4321
# WEBAUTHN_RP_NAME=Maildrill
# TRUSTED_DEVICE_TTL_DAYS=60  SESSION_TTL_DAYS=30  REAUTH_WINDOW_MINUTES=10

# Transactional email — Cloudflare Email Service SMTP relay. Carries ALL
# transactional mail: the Astro welcome/notification sender AND the workers
# login-code/welcome path both read these keys (campaign email stays on
# Infobip). Host is smtp.mx.cloudflare.net, user `api_token`, pass a Cloudflare
# API token with Email Sending permission. Leave blank to no-op.
SMTP_HOST=smtp.mx.cloudflare.net
# Cloudflare Email Service SMTP is SMTPS on 465 only (no STARTTLS / 587).
SMTP_PORT=465
SMTP_USER=api_token
SMTP_PASS=
# SMTP_SECURE=true
MAIL_FROM="Maildrill <hello@maildrill.net>"
SIGNUP_NOTIFY_TO=hello@laravel42.com

# Registration is open when this is empty: verifying a sign-in code creates the
# user, their workspace and its Infobip entity. Set a comma-separated list of
# addresses to close it down to a private rollout again.
PUBLIC_LOGIN_ALLOWLIST=

# Infobip portal pricing sync (offline scrape; no portal password stored)
INFOBIP_PORTAL_URL=https://portal.infobip.com
INFOBIP_PRICING_PATH=/pricing

# =============================================================================
# workers/ backend
# =============================================================================

# --- Application ---
NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=3002
PRODUCT_API_PORT=3001
# EB_PORT=3003

# Node Telescope at /__telescope. On in non-prod by default; 1=on, 0=off.
TELESCOPE_ENABLED=1

# --- PostgreSQL ---
DATABASE_URL=postgres://maildrill:maildrill@localhost:5432/maildrill
PG_POOL_MAX=10

# --- Redis / Valkey ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Comma-separated "keyId:secret" pairs for API-key auth
API_KEYS=dev-key:dev-secret
# JWT_SECRET set above (must match Astro)

APP_URL=http://localhost:4321
MAGIC_LINK_TTL_MINUTES=15

# --- Infobip ---
INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
INFOBIP_API_KEY=
# Optional: DLR push target stamped on WhatsApp/SMS/Voice sends (paired with
# callbackData so PostHog/the poller can reconcile the report). Typically the
# PostHog Infobip webhook `?kind=delivery`. Empty → portal subscriptions + pull.
INFOBIP_NOTIFY_URL=
# Optional: open/click/unsub/complaint push (PostHog webhook `?kind=tracking`).
# Empty → derived from INFOBIP_NOTIFY_URL with kind=tracking.
INFOBIP_TRACKING_URL=
# --- Provider-billed usage reconciliation (Infobip Billing Usage API) --------
# After a campaign finishes, Maildrill asks Infobip what it actually cost and
# posts the difference against the local estimate to the wallet. The query is
# asynchronous: Infobip POSTs the result to this URL ONCE, with no retry, so it
# must be publicly reachable before anything is submitted. Empty → the whole
# reconciliation stays off and costs remain estimates.
INFOBIP_BILLING_CALLBACK_URL=
# Unguessable token appended as `?token=` and required back on every callback.
# Infobip signs nothing here, so this IS the authentication. Refused at boot in
# production if the callback URL is set and this is left at a default.
INFOBIP_BILLING_CALLBACK_TOKEN=
# auto (default) | direct | posthog.
#
# `auto` uses INFOBIP_BILLING_CALLBACK_URL when it and its token are set, and
# otherwise falls back to the PostHog webhook already receiving Infobip DLRs —
# INFOBIP_NOTIFY_URL with `kind=delivery` swapped for `kind=billing`. That path
# needs nothing of ours to be publicly reachable, which is why it is the
# default, but it does need POSTHOG_PERSONAL_API_KEY: the result lands in
# PostHog rather than in our process, so a poller pulls it back out every 2
# minutes (see `pullBillingUsageResults`).
#
# Using PostHog requires ONE branch in the Hog function behind that webhook:
#
#   if (inputs.kind == 'billing') {
#     postHogCapture({
#       event: 'infobip_billing_usage_result',
#       distinct_id: request.body.requestId,
#       properties: {
#         requestId: request.body.requestId,
#         payload: jsonStringify(request.body),
#       },
#     })
#   }
#
# `payload` must be stringified: `response.rows` is an array of arrays whose
# ORDER carries the meaning (the columns are positional), and a nested object
# comes back through HogQL reshaped.
#
# Nothing is trusted from that webhook. A result is only ingested if its
# requestId matches a request row Maildrill created, which is unforgeable
# without having seen the submission — the endpoint itself accepts any POST.
INFOBIP_BILLING_CALLBACK_TRANSPORT=auto
# Channels whose sends carry `campaignReferenceId` — the tag that makes billing
# attributable to one campaign. Only email and SMS are on by default: those are
# the two whose field placement Infobip's OpenAPI spec documents (message-level
# for /sms/2/text/advanced, messages[].options for /email/4/messages). Add
# `whatsapp,voice` once verified against a live account; an unknown property on
# those endpoints would fail the send itself.
INFOBIP_CAMPAIGN_REF_CHANNELS=email,sms
INFOBIP_FROM=no-reply@maildrill.net
INFOBIP_PHONE_FROM=
INFOBIP_SMS_FROM=
INFOBIP_WHATSAPP_FROM=
INFOBIP_VOICE_FROM=
# Calls Configuration ID (Calls API + WebRTC) — powers the in-browser voice
# template preview (real Infobip TTS voice over a silent WebRTC call).
# Create via POST /calls/1/configurations. Empty → preview returns 501.
INFOBIP_CALLS_CONFIGURATION_ID=
# CPaaS X identity stamped on every Infobip request. INFOBIP_APPLICATION_ID is
# the account's application (the portal's Default Application unless you made
# another). INFOBIP_ENTITY_ID is only the ACCOUNT-WIDE FALLBACK: each workspace
# gets its own entity (`ws-<tenant-uuid>`, stored on tenants.infobip_entity_id)
# and that wins whenever it is set. Leave the entity blank on a single-tenant
# account. Placeholder values (local/test/example/changeme) are dropped rather
# than sent — Infobip rejects a message outright for an unknown entity.
INFOBIP_APPLICATION_ID=
INFOBIP_ENTITY_ID=
# Outbound send throttle (messages/sec), in-process, on top of (not instead
# of) DISPATCH_CONCURRENCY and the dispatch worker's own global RATE_LIMIT_MAX
# limiter. 0 = unthrottled (historical default).
INFOBIP_MAX_SEND_RATE=0
PROVIDER_DRIVER=mock

# --- Cloudflare Email Service (campaign email driver) ---
# Routes ONLY the email channel through Cloudflare's Email Sending REST API
# while SMS/WhatsApp/Voice stay on PROVIDER_DRIVER. Set PROVIDER_EMAIL_DRIVER
# to `cloudflare` to enable (or use it as the global PROVIDER_DRIVER — but that
# rejects every non-email channel). Distinct from the SMTP relay above, which
# carries transactional mail only.
# The From domain must be onboarded: npx wrangler email sending enable maildrill.net
PROVIDER_EMAIL_DRIVER=
CLOUDFLARE_ACCOUNT_ID=
# API token with the Email Sending permission (Bearer)
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_FROM=no-reply@maildrill.net
# Delivery events (delivered/deferred/bounced/failed/rejected/complained):
# create a queue + event subscription (dashboard → Queues → Event subscriptions,
# source "Email Sending"), then set the queue id — the cloudflare-email-events
# poller pulls it. Token needs Queues Read+Write; empty → reuses the email token.
CLOUDFLARE_EVENTS_QUEUE_ID=
CLOUDFLARE_EVENTS_API_TOKEN=
CLOUDFLARE_EVENTS_POLL_INTERVAL_MS=10000
# Same per-provider throttle as INFOBIP_MAX_SEND_RATE, scoped to Cloudflare.
CLOUDFLARE_MAX_SEND_RATE=0

# --- AWS SES (campaign email driver) ---
# A second, interchangeable campaign email driver — same PROVIDER_EMAIL_DRIVER
# switch as Cloudflare above (set it to `ses` instead of `cloudflare` to
# enable this one; the two are mutually exclusive since it's one switch).
#
# Credentials are NEVER read from env here — the SES client uses the standard
# AWS SDK v3 credential provider chain: an IAM role (ECS task role / EC2
# instance role / EKS service account) in every real deployment, or the
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY already set below for S3 media in
# local dev. Only the region and sending identity are Maildrill-specific.
#
# AWS_SES_REGION and AWS_SES_FROM_EMAIL are REQUIRED the moment SES is
# selected for any channel — config validation fails fast at startup
# otherwise. AWS_SES_FROM_EMAIL must be an SES-verified identity.
AWS_SES_REGION=eu-central-1
AWS_SES_FROM_EMAIL=hello@laravel42.com
# Configuration Set to attach to every send — required for delivery events
# (bounce/complaint/delivery/open/click/…) to reach anywhere at all. Create
# one, add an "Amazon SNS" event destination for every event type you want.
# Production: point that SNS topic's HTTPS subscription at a PostHog Hog
# function (same SNS→PostHog architecture Infobip already uses — see
# workers/docs/posthog-ses-hog.md); campaign-delivery.ts needs zero
# SES-specific code once it does. A direct-to-Maildrill fallback also exists
# for manual testing: https://<api-host>/webhooks/ses/sns?secret=<WEBHOOK_INFOBIP_SECRET>
# (auto-confirms the SNS subscription handshake on first delivery).
AWS_SES_CONFIGURATION_SET=amzn-ses-maildrill-config-set
# Same per-provider throttle as INFOBIP_MAX_SEND_RATE, scoped to SES. Set
# this just under whatever `aws sesv2 get-account` reports as the account's
# granted max send rate, divided by the number of running dispatch worker
# replicas (each process enforces its own local ceiling). 14/s is a
# conservative starting point (a brand-new SES account's typical quota) —
# raise once the account's real grant is confirmed.
SES_MAX_SEND_RATE=14
# Redis-backed daily send cap for SES, shared fleet-wide (unlike the
# per-second rate above, which is per-process). 50,000/day is a conservative
# starting ceiling; raise alongside SES_MAX_SEND_RATE once the account's
# granted daily quota is confirmed. 0 = uncapped.
SES_MAX_SEND_PER_DAY=50000
# Per-workspace SES Tenant isolation is automatic (no env var) — every
# workspace is assigned an SES Tenant at creation and every send is tagged
# with it, so one workspace's bounces/complaints never affect another's
# reputation inside this shared account. See workers/docs/email-providers.md.

# --- Webhooks ---
# Used by Maildrill Infobip webhook routes (mock/tests; prod DLRs go to PostHog).
# Production rejects the default — set a strong secret if those routes are exposed.
WEBHOOK_INFOBIP_SECRET=change-me

# --- PostHog HogQL (Analytics + campaign delivery poller) ---
# Personal API key with Query Read — not the project write token (phc_).
# See workers/docs/posthog-infobip-hog.md
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=526344
POSTHOG_APP_HOST=https://us.posthog.com
POSTHOG_STATS_ENABLED=
# Ingest token (phc_) OF THE PROJECT ABOVE — used by `pnpm db:seed` to mirror
# seeded provider events into PostHog. NOT the same as
# PUBLIC_POSTHOG_PROJECT_TOKEN, which belongs to the marketing-site project.
POSTHOG_PROJECT_API_KEY=
# Ingestion host for the key above (capture, not query). Workers write
# billing-usage results here; the app host is for HogQL reads.
POSTHOG_INGEST_HOST=https://us.i.posthog.com

# --- Campaign delivery poller ---
CAMPAIGN_DELIVERY_POLL_INTERVAL_MS=5000

# --- WhatsApp template approval poller ---
TEMPLATE_APPROVAL_POLL_INTERVAL_MS=60000

# --- Worker / dispatch tuning ---
DISPATCH_CONCURRENCY=10
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_BACKOFF_MS=2000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
SCHEDULER_INTERVAL_MS=5000
SCHEDULER_BATCH_SIZE=200

# --- Rate limits ---
RATE_LIMIT_MAX=100
RATE_LIMIT_DURATION_MS=1000

# --- EmailBuilder.js AI (workers) ---
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-5-mini
OPENAI_API_KEY=
# Optional override for Media Library vision name/tag suggest (default gpt-4o)
# MEDIA_SUGGEST_MODEL=gpt-4o
UNSPLASH_API_KEY=
UNSPLASH_APP_NAME=Maildrill

# --- Media library (S3 + CloudFront) ---
AWS_REGION=
MEDIA_S3_BUCKET=
MEDIA_CDN_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_MAX_BYTES=15728640

# --- Billing (Stripe checkout + webhooks; wallet/ledger live in Postgres) ---
# Provider: `stripe` for real payments, `mock` for local dev without network.
BILLING_PROVIDER=stripe
# sk_live_… / sk_test_… — server-only, never PUBLIC_*.
STRIPE_SECRET_KEY=
# whsec_… from the Stripe webhook endpoint (required whenever the secret key is set).
STRIPE_WEBHOOK_SECRET=
# `1` = sends require credits (reserve → commit → release). Default off.
BILLING_ENFORCEMENT=0
# Stale credit holds are swept back to the wallet after this many minutes.
BILLING_RESERVATION_TTL_MINUTES=120

# --- Automations (visual workflows) ------------------------------------------
# Execution budgets. These are the blast radius of a badly-built workflow, so
# they are enforced by the engine rather than trusted to the composer: the step
# budget stops a router that points back at itself, the wall clock stops a run
# waiting on a dead provider, and the payload cap stops a webhook parking
# megabytes in `trigger_payload`. Defaults are production-sane; every value here
# is optional.
AUTOMATION_MAX_STEPS_PER_RUN=100
AUTOMATION_MAX_LOOP_ITERATIONS=200
# Wall clock for one SEGMENT of a run (between waits), not the whole workflow —
# a two-day Wait has not been "executing" for two days.
AUTOMATION_RUN_TIMEOUT_MS=120000
AUTOMATION_MAX_PAYLOAD_BYTES=131072

# HTTP-request action. `AUTOMATION_HTTP_ALLOW_PRIVATE=1` lets a workflow reach
# loopback/private/link-local addresses — i.e. it turns the SSRF guard off, and
# with it the protection around the cloud metadata endpoint. Only ever for a
# local development stack.
AUTOMATION_HTTP_MAX_RESPONSE_BYTES=1048576
AUTOMATION_HTTP_TIMEOUT_MS=15000
AUTOMATION_HTTP_MAX_REDIRECTS=3
AUTOMATION_HTTP_ALLOW_PRIVATE=0

# Worker tuning. The dispatcher drains `automation_events` into runs; the resume
# sweep is the DURABLE half of long waits (a three-month delay is not held as a
# Redis job) and also rescues runs whose worker died mid-step.
AUTOMATION_RUN_CONCURRENCY=5
AUTOMATION_DISPATCH_INTERVAL_MS=1000
AUTOMATION_DISPATCH_BATCH_SIZE=50
AUTOMATION_RESUME_INTERVAL_MS=15000
AUTOMATION_STALL_MS=300000

# Segment enter/exit triggers. Segments are rule-derived, so membership has to be
# diffed on a schedule rather than observed from a write — this interval IS the
# latency of those two triggers.
AUTOMATION_SEGMENT_POLL_INTERVAL_MS=60000
AUTOMATION_SEGMENT_MAX_SUBSCRIBERS=5000

# One runaway automation must not consume every worker slot in the cluster.
# 0 disables the cap.
AUTOMATION_MAX_CONCURRENT_RUNS_PER_TENANT=50
