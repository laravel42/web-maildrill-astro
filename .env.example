###############################################################################
# Monorepo root .env.example — Astro site + workers/ backend
# Copy to `.env` at the repo root and fill in secrets. Never commit `.env`.
# workers/ loads this file automatically (see packages/config).
###############################################################################

# =============================================================================
# Astro site (web-maildrill-astro)
# =============================================================================

# Public site URL (canonicals, sitemap, OG)
PUBLIC_SITE_URL=https://maildrill.net

# Browser PostHog — use PUBLIC_POSTHOG_PROJECT_TOKEN (project write token `phc_…`).
# PUBLIC_POSTHOG_KEY is legacy/unused; leave empty.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
PUBLIC_POSTHOG_PROJECT_TOKEN=

# Auth.js session secret — openssl rand -base64 32
AUTH_SECRET=

# BFF → workers product-api (cd workers && pnpm dev)
API_BASE_URL=http://localhost:3001

# Shared with workers/ — Astro mints tenant JWTs; product-api verifies them.
# Production must use a strong secret (not change-me*). openssl rand -base64 32
JWT_SECRET=change-me-in-production

# Account security (passkeys + TOTP 2FA) — read by workers/.
# SECURITY_ENCRYPTION_KEY encrypts TOTP secrets at rest (AES-256-GCM).
# 32 bytes: openssl rand -base64 32. Empty in dev derives a key from
# JWT_SECRET with a boot warning; PRODUCTION REQUIRES IT before anyone
# enables an authenticator (setup throws without it).
SECURITY_ENCRYPTION_KEY=
# WebAuthn relying party: the registrable domain the app is served on, and
# the exact origins allowed to complete ceremonies (comma-separated).
# Production: WEBAUTHN_RP_ID=maildrill.net / WEBAUTHN_ORIGINS=https://maildrill.net
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:4321
# WEBAUTHN_RP_NAME=Maildrill
# TRUSTED_DEVICE_TTL_DAYS=60  SESSION_TTL_DAYS=30  REAUTH_WINDOW_MINUTES=10

# Transactional email — Cloudflare Email Service SMTP relay. Carries ALL
# transactional mail: the Astro welcome/notification sender AND the workers
# login-code/welcome path both read these keys (campaign email stays on
# Infobip). Host is smtp.mx.cloudflare.net, user `api_token`, pass a Cloudflare
# API token with Email Sending permission. Leave blank to no-op.
SMTP_HOST=smtp.mx.cloudflare.net
# Cloudflare Email Service SMTP is SMTPS on 465 only (no STARTTLS / 587).
SMTP_PORT=465
SMTP_USER=api_token
SMTP_PASS=
# SMTP_SECURE=true
MAIL_FROM="Maildrill <hello@maildrill.net>"
SIGNUP_NOTIFY_TO=hello@laravel42.com

# EmailBuilder AI/image proxy (/api/eb/*, /api/images/*). Unified workers
# `pnpm dev` serves these on PRODUCT_API_PORT (3001). Use :3100 only with
# standalone `pnpm --dir workers dev:email-builder-api`.
API_BASE_URL=http://localhost:3001

# Infobip portal pricing sync (offline scrape; no portal password stored)
INFOBIP_PORTAL_URL=https://portal.infobip.com
INFOBIP_PRICING_PATH=/pricing

# =============================================================================
# workers/ backend
# =============================================================================

# --- Application ---
NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=3000
PRODUCT_API_PORT=3001

# Node Telescope at /__telescope. On in non-prod by default; 1=on, 0=off.
TELESCOPE_ENABLED=1

# --- PostgreSQL ---
DATABASE_URL=postgres://maildrill:maildrill@localhost:5432/maildrill
PG_POOL_MAX=10

# --- Redis / Valkey ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Comma-separated "keyId:secret" pairs for API-key auth
API_KEYS=dev-key:dev-secret
# JWT_SECRET set above (must match Astro)

APP_URL=http://localhost:4321
MAGIC_LINK_TTL_MINUTES=15

# --- Infobip ---
INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
INFOBIP_API_KEY=
# Optional: DLR push target stamped on WhatsApp/SMS/Voice sends (paired with
# callbackData so PostHog/the poller can reconcile the report). Typically the
# PostHog Infobip webhook `?kind=delivery`. Empty → portal subscriptions + pull.
INFOBIP_NOTIFY_URL=
# Optional: open/click/unsub/complaint push (PostHog webhook `?kind=tracking`).
# Empty → derived from INFOBIP_NOTIFY_URL with kind=tracking.
INFOBIP_TRACKING_URL=
INFOBIP_FROM=no-reply@maildrill.net
INFOBIP_PHONE_FROM=
INFOBIP_SMS_FROM=
INFOBIP_WHATSAPP_FROM=
INFOBIP_VOICE_FROM=
# Calls Configuration ID (Calls API + WebRTC) — powers the in-browser voice
# template preview (real Infobip TTS voice over a silent WebRTC call).
# Create via POST /calls/1/configurations. Empty → preview returns 501.
INFOBIP_CALLS_CONFIGURATION_ID=
INFOBIP_APPLICATION_ID=
INFOBIP_ENTITY_ID=
PROVIDER_DRIVER=mock

# --- Cloudflare Email Service (campaign email driver) ---
# Routes ONLY the email channel through Cloudflare's Email Sending REST API
# while SMS/WhatsApp/Voice stay on PROVIDER_DRIVER. Set PROVIDER_EMAIL_DRIVER
# to `cloudflare` to enable (or use it as the global PROVIDER_DRIVER — but that
# rejects every non-email channel). Distinct from the SMTP relay above, which
# carries transactional mail only.
# The From domain must be onboarded: npx wrangler email sending enable maildrill.net
PROVIDER_EMAIL_DRIVER=
CLOUDFLARE_ACCOUNT_ID=
# API token with the Email Sending permission (Bearer)
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_FROM=no-reply@maildrill.net
# Delivery events (delivered/deferred/bounced/failed/rejected/complained):
# create a queue + event subscription (dashboard → Queues → Event subscriptions,
# source "Email Sending"), then set the queue id — the cloudflare-email-events
# poller pulls it. Token needs Queues Read+Write; empty → reuses the email token.
CLOUDFLARE_EVENTS_QUEUE_ID=
CLOUDFLARE_EVENTS_API_TOKEN=
CLOUDFLARE_EVENTS_POLL_INTERVAL_MS=10000

# --- Webhooks ---
# Used by Maildrill Infobip webhook routes (mock/tests; prod DLRs go to PostHog).
# Production rejects the default — set a strong secret if those routes are exposed.
WEBHOOK_INFOBIP_SECRET=change-me

# --- PostHog HogQL (Analytics + campaign delivery poller) ---
# Personal API key with Query Read — not the project write token (phc_).
# See workers/docs/posthog-infobip-hog.md
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=526344
POSTHOG_APP_HOST=https://us.posthog.com
POSTHOG_STATS_ENABLED=
# Ingest token (phc_) OF THE PROJECT ABOVE — used by `pnpm db:seed` to mirror
# seeded provider events into PostHog. NOT the same as
# PUBLIC_POSTHOG_PROJECT_TOKEN, which belongs to the marketing-site project.
POSTHOG_PROJECT_API_KEY=

# --- Campaign delivery poller ---
CAMPAIGN_DELIVERY_POLL_INTERVAL_MS=5000

# --- WhatsApp template approval poller ---
TEMPLATE_APPROVAL_POLL_INTERVAL_MS=60000

# --- Worker / dispatch tuning ---
DISPATCH_CONCURRENCY=10
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_BACKOFF_MS=2000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
SCHEDULER_INTERVAL_MS=5000
SCHEDULER_BATCH_SIZE=200

# --- Rate limits ---
RATE_LIMIT_MAX=100
RATE_LIMIT_DURATION_MS=1000

# --- EmailBuilder.js AI (workers) ---
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-5-mini
OPENAI_API_KEY=
# Optional override for Media Library vision name/tag suggest (default gpt-4o)
# MEDIA_SUGGEST_MODEL=gpt-4o
UNSPLASH_API_KEY=
UNSPLASH_APP_NAME=Maildrill

# --- Media library (S3 + CloudFront) ---
AWS_REGION=
MEDIA_S3_BUCKET=
MEDIA_CDN_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_MAX_BYTES=15728640
