# Public site URL (used for canonicals, sitemap, OG)
PUBLIC_SITE_URL=https://maildrill.com

# Optional analytics (never put private keys in PUBLIC_* vars)
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=

# Server-only placeholders for future auth / API integration
AUTH_SECRET=
API_BASE_URL=

# Infobip API key (server-side only; note: the account rate card is NOT exposed
# via any API-key endpoint — see scripts/sync-infobip-rates.mjs)
INFOBIP_API_KEY=

# Infobip portal pricing sync (offline scrape via headless Chromium + saved
# login session). Login is manual, so no portal password is stored here.
INFOBIP_PORTAL_URL=https://portal.infobip.com
INFOBIP_PRICING_PATH=/pricing