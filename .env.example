# Public site URL (used for canonicals, sitemap, OG)
PUBLIC_SITE_URL=https://maildrill.app

# Optional analytics (never put private keys in PUBLIC_* vars)
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=

# Server-only: Auth.js + maildrill-service (backend) integration
AUTH_SECRET=                          # Auth.js session secret — openssl rand -base64 32
API_BASE_URL=http://localhost:3001    # maildrill-service product API base URL
JWT_SECRET=change-me-in-production     # shared with maildrill-service; mints tenant JWTs

# SMTP for the in-repo welcome email (temporary — sent from /api/signup-welcome
# via Nodemailer, no maildrill-service needed). Leave blank to no-op (the
# sign-up flow still works; the email is just skipped and logged).
SMTP_HOST=
SMTP_PORT=587                          # 465 = implicit TLS; 587/25 = STARTTLS
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true                     # override auto-detect (defaults to port===465)
# Must equal the authenticated SMTP mailbox (providers like forwardemail.net
# reject a mismatched From with a 550), so keep it on the sending domain.
MAIL_FROM="Maildrill <hello@maildrill.app>"
# Where new-sign-up notifications are sent (defaults to hello@laravel42.com).
SIGNUP_NOTIFY_TO=hello@laravel42.com

# EmailBuilder.js AI/image backend (@eb/backend) — proxied via /api/eb/*.
# Defaults to http://localhost:3100 when unset. Provider keys live in that
# service's own .env (OPENAI_API_KEY, UNSPLASH_API_KEY), never here.
EB_BACKEND_URL=http://localhost:3100

# Infobip API key (server-side only; note: the account rate card is NOT exposed
# via any API-key endpoint — see scripts/sync-infobip-rates.mjs)
INFOBIP_API_KEY=

# Infobip portal pricing sync (offline scrape via headless Chromium + saved
# login session). Login is manual, so no portal password is stored here.
INFOBIP_PORTAL_URL=https://portal.infobip.com
INFOBIP_PRICING_PATH=/pricing