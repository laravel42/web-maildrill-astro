---
export const prerender = false;
import AppLayout from '@/layouts/AppLayout.astro';
import AppDashboard from '@/components/react/AppDashboard';
import { productClient } from '@/lib/server/service';
import { toCampaigns, type ApiCampaign } from '@/lib/app/campaign-map';
import type { ActivityPoint, Summary } from '@/components/react/AppDashboard.logic';
import type { Campaign } from '@/types/app';

// Live workspace counters; null = not connected, so the KPIs render "—" rather
// than a fabricated zero.
const session = Astro.locals.session;
let summary: Summary | null = null;
let campaigns: Campaign[] = [];
let daily: ActivityPoint[] = [];
let banner: { ok: boolean; text: string } | null = null;

const hour = Number(
  new Intl.DateTimeFormat('en-US', { hour: 'numeric', hour12: false, timeZone: 'UTC' }).format(
    new Date(),
  ),
);
const greeting = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';

if (session?.user?.id && session.activeTenantId) {
  try {
    const client = productClient({
      userId: session.user.id,
      activeTenantId: session.activeTenantId,
      role: session.role,
    });
    const [summaryRes, campaignsRes, activityRes] = await Promise.all([
      client.GET('/v1/stats/summary'),
      client.GET('/v1/campaigns'),
      client.GET('/v1/stats/activity', { params: { query: { days: 30 } } }),
    ]);
    if (summaryRes.error) {
      banner = { ok: false, text: 'workers returned an error.' };
    } else {
      summary = summaryRes.data as unknown as Summary;
    }
    campaigns = toCampaigns(
      (campaignsRes.data as unknown as { data?: ApiCampaign[] })?.data ?? [],
    );
    daily = (activityRes.data as unknown as { data?: ActivityPoint[] })?.data ?? [];
  } catch (err) {
    banner = { ok: false, text: err instanceof Error ? err.message : 'Service unreachable.' };
  }
}
---

<AppLayout title="Dashboard">
  {banner && <div class={`svc-banner ${banner.ok ? 'ok' : 'err'}`}>{banner.text}</div>}
  <AppDashboard
    client:visible
    summary={summary}
    campaigns={campaigns}
    daily={daily}
    greeting={greeting}
  />
</AppLayout>

<style>
  .svc-banner {
    margin: 0 0 14px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12.5px;
  }
  .svc-banner.ok {
    border: 1px solid #16a34a;
    background: #f0fdf4;
    color: #166534;
  }
  .svc-banner.err {
    border: 1px solid #dc2626;
    background: #fef2f2;
    color: #991b1b;
  }
</style>
