  .result__label {
    font-size: var(--fs-base);
    color: var(--ink-band-text2);
    margin-top: 8px;
  }

  /* ---- VOICES ---- */
  /* ---- PRODUCT TOUR ----
     A scroll-snap carousel. The scroller is the source of truth for "which
     slide is showing" — arrows and dots scroll it rather than tracking their
     own index, so a trackpad swipe, a dot click and an arrow key can never
     disagree about where the carousel is. */
  .tour {
    --tour-gap: 34px;
    /* Sized against the FRAME (container query unit), never the track's own
       content box: the track's edge padding is derived from this width, so a
       percentage here would feed back into itself and collapse the cards. */
    --tour-card-w: calc((100cqi - 2 * var(--tour-gap)) / 3);
    /* Room either side so the first and last card can reach dead centre —
       without it they pin to the edges and can never become the active one. */
    --tour-edge-pad: calc((100cqi - var(--tour-card-w)) / 2);
    /* The raised centre card. Card width x scale must stay under 100cqi or the
       scroller — which clips on both axes — cuts the card off left and right,
       so every breakpoint that changes --tour-card-w has to check this. */
    --tour-scale-on: 1.3;
    --tour-scale-off: 0.84;
    /* Room the raised centre card overflows into. The track reserves it as
       padding and pulls it back out with a negative margin (see .tour__track),
       and that negative margin collapses through the frame — so whatever
       follows the strip has to add it back to look spaced. Covers half the
       30% overflow on the tallest card plus its shadow. */
    --tour-overflow: 88px;
    /* The only real space below the strip — the section's own bottom padding is
       0 and --tour-overflow is pulled back out of the layout. */
    --tour-tail: calc(60px * var(--sec-y));
    /* Generous above, nothing below: the section runs into the footer's
       "Get started" banner, which supplies its own top spacing. */
    padding-block: calc(88px * var(--sec-y)) 0;
  }
  .tour__title {
    /* Owns the gap down to the strip: a top margin on .tour__frame would just
       collapse into this one. */
    margin: 14px 0 112px;
  }
  .tour__frame {
    position: relative;
    /* Query container for --tour-card-w / --tour-edge-pad above. */
    container-type: inline-size;
  }
  /* The strip sits under the arrows; the track creates no stacking context of
     its own. Scoping stamps an attribute on both compound selectors here, so
     this outweighs a bare `.tour__arrow` — anything that needs different
     positioning has to say so through the same child selector. */
  .tour__frame > * {
    position: relative;
    z-index: 1;
  }
  .tour__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-auto-flow: column;
    /* Three across, so the strip reads as a gallery you can scan rather than
       one screenshot at a time. The gap is subtracted before dividing, or the
       third card is pushed past the right edge. */
    grid-auto-columns: var(--tour-card-w);
    gap: var(--tour-gap);
    /* Lets first/last slides be truly centerable instead of pinning left/right. */
    padding-inline: var(--tour-edge-pad);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    /* A scroll container clips on BOTH axes, so the centre card — scaled to
       1.3 — was being cut off top and bottom, and the cards' shadows with it.
       The padding reserves that room and the negative margin takes it back
       out of the layout, so the strip sits exactly where it did. The extra
       --tour-tail below is the one part that is NOT pulled back, so it reads as
       real space under the strip. */
    padding-block: var(--tour-overflow) calc(var(--tour-overflow) + var(--tour-tail));
    margin-block: calc(var(--tour-overflow) * -1);
    scrollbar-width: none;
  }
  .tour__track::-webkit-scrollbar {
    display: none;
  }
  .tour__track:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 6px;
    border-radius: 22px;
  }
  /* Centre card foregrounded: the one being read is full size and opaque, its
     neighbours sit back. Done with transform and opacity rather than by giving
     the centre track a wider column — a width change would reflow the whole
     strip on every scroll tick and fight the snap. Scaling leaves layout
     untouched, so the snap positions stay exactly where they were. */
  .tour__slide {
    scroll-snap-align: center;
    min-width: 0;
    /* The centre card grows past its track while its neighbours shrink well
       back — the 34px gap absorbs the overflow, so nothing overlaps. */
    transform: scale(var(--tour-scale-off));
    opacity: 0.42;
    transition:
      transform 0.32s var(--ease-out, cubic-bezier(0.2, 0.7, 0.3, 1)),
      opacity 0.32s ease;
  }
  .tour__slide.is-active {
    transform: scale(var(--tour-scale-on));
    opacity: 1;
    /* Above its neighbours so the raised card's shadow reads correctly. */
    position: relative;
    z-index: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .tour__slide {
      transition: none;
    }
  }
  .tour__fig {
    margin: 0;
  }
  /* Chrome + screenshot form one window: the border, radius and shadow live on
     the figure so the two pieces share an outline, rather than each carrying
     its own and meeting at a visible seam. */
  .tour__fig {
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 24px 60px rgba(28, 25, 23, 0.14);
    /* Fill the (already equal-height) grid item, so a caption that wraps to a
       third line at some widths lengthens its own card instead of leaving the
       row of cards ragged. The caption takes up the slack. */
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .tour__chrome {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 10px;
    height: 32px;
    background: var(--surface-2, rgba(128, 122, 112, 0.09));
    border-bottom: 1px solid var(--border);
  }
  .tour__lights {
    display: flex;
    gap: 5px;
    flex: none;
  }
  .tour__lights i {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--border);
  }
  /* Tinted, not literal macOS red/amber/green: the frame should read as "an
     app in a browser", not as a screenshot of one specific operating system. */
  .tour__lights i:nth-child(1) {
    background: #ec6a5e;
  }
  .tour__lights i:nth-child(2) {
    background: #f4bf4f;
  }
  .tour__lights i:nth-child(3) {
    background: #61c454;
  }
  .tour__tab {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: none;
    max-width: 77px;
    padding: 2.4px 6.4px;
    border-radius: 6.4px 6.4px 0 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-bottom: 0;
    margin-bottom: -1px;
    font-size: 7px;
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
  }
  .tour__tabname {
    min-width: 0;
    overflow: hidden;
  }
  /* Same split as the real wordmark in Logo.astro, so the chrome shows the
     brand as it's actually written rather than as flat text. */
  .tour__brand {
    color: var(--brand);
  }
  .tour__favicon {
    width: 8.8px;
    height: 8.8px;
    flex: none;
  }
  .tour__url {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex: 1 1 auto;
    min-width: 0;
    height: 20px;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tour__lock {
    width: 11px;
    height: 11px;
    flex: none;
  }
  .tour__fig img {
    display: block;
    width: 100%;
    height: auto;
  }
  .tour__fig figcaption {
    display: block;
    flex: 1;
    padding: 14px 15px 16px;
    border-top: 1px solid var(--border);
  }
  .tour__fig figcaption strong {
    display: block;
    /* Matches .feat__title: 14.5px against the centre card's 1.3 scale lands on
       the same ~19px, and the tracking is em-based so it holds at every scale. */
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 4px;
  }
  .tour__fig figcaption span {
    display: block;
    /* Matches .feat__desc: 11.5px against the centre card's 1.3 scale lands on
       the same ~15px, with its 1.6 leading and --text3 rather than --muted. */
    color: var(--text3);
    font-size: 11.5px;
    line-height: 1.6;
    /* Two lines for every card, so a short caption and a long one leave the
       row of cards the same height instead of ragged. */
    min-height: 2lh;
  }

  .tour__frame > .tour__arrow {
    position: absolute;
    top: 0;
    z-index: 2;
    /* Centred on the IMAGE, not the figure: the caption below would drag the
       arrows off-centre and they would drift as caption lengths differ. */
    height: 68%;
    display: grid;
    place-items: center;
    width: 52px;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .tour__arrow svg {
    width: 22px;
    height: 22px;
    padding: 9px;
    box-sizing: content-box;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 6px 18px rgba(28, 25, 23, 0.16);
  }
  .tour__arrow--prev {
    left: -14px;
  }
  .tour__arrow--next {
    right: -14px;
  }
  .tour__frame:hover .tour__arrow,
  .tour__arrow:focus-visible {
    opacity: 1;
  }
  /* Reveal-on-hover needs a pointer that hovers. On touch these would be
     tappable but permanently invisible, and since the dots came out the arrows
     are the only control the reel has besides the swipe itself. */
  @media (hover: none) {
    /* Matched through .tour__frame to outrank the base rule's `opacity: 0`. */
    .tour__frame > .tour__arrow {
      opacity: 1;
    }
  }
  .tour__arrow[disabled] {
    opacity: 0 !important;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .tour__track {
      scroll-behavior: auto;
    }
  }
  @media (max-width: 1080px) {
    .tour {
      --tour-card-w: calc((100cqi - var(--tour-gap)) / 2);
    }
  }
  @media (max-width: 720px) {
    .tour {
      /* One card at a time, and no raise: scaling the centre card up here
         would force it narrower than the desktop card to avoid the scroller's
         clipping edges, which leaves the fixed-size caption dwarfing the
         screenshot. Opacity alone marks the active card instead, and the width
         goes to the screenshot.

         The three values are tuned together to keep the neighbours visible.
         What shows of a neighbour is (100cqi - card) / 2 - gap, less the width
         the shrink pulls back from its inner edge — so a deep --tour-scale-off
         can swallow the peek entirely and leave the reel looking like a single
         static card. A shallow shrink buys most of it back. */
      --tour-card-w: 76cqi;
      --tour-gap: 10px;
      --tour-scale-on: 1;
      --tour-scale-off: 0.94;
    }
    /* The tab label is the least load-bearing part of the chrome, and the URL
       is what actually says which screen this is. */
    .tour__tab {
      display: none;
    }
    .tour__chrome {
      height: 36px;
    }
  }
</style>

<script>
  type TourTrackEl = HTMLElement & {
    __tourCleanup?: () => void;
  };

  /**
   * Product tour carousel.
   *
   * One `index` owns the current slide and every scroll target is that card's
   * centre, so an arrow click and an arrow key can never disagree about where
   * the carousel is; a trackpad swipe hands control back by adopting whatever
   * card the scroller settled on. It advances only when the visitor asks it
   * to — there is no autoplay. The arrows are hidden in the markup and
   * revealed here, so no-JS visitors get a plain scrollable strip rather than
   * buttons that do nothing.
   */
  const track = document.getElementById('tour-track') as TourTrackEl | null;
  const prev = document.querySelector<HTMLButtonElement>('[data-tour-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-tour-next]');

  if (track && prev && next) {
    // One authoritative `index`; every scroll target is that card's centre.
    // No in-flight/queued transition state — a click just moves the index and
    // scrolls, and a manual swipe adopts whatever card the scroller settled on.
    // Full teardown before re-init (HMR/view transitions).
    track.__tourCleanup?.();

    const events = new AbortController();
    const { signal } = events;

    const real = Array.from(track.children) as HTMLElement[];
    if (real.length > 0) {
      for (const el of [prev, next]) el.hidden = false;

      // A looping reel. Without copies of the tail before the head (and the
      // head after the tail) the first and last cards sit beside an empty slot,
      // because there is no neighbour to show there. Clones fill those slots;
      // when the strip settles on one it jumps to the identical real card,
      // which is invisible precisely because both positions render the same
      // three cards.
      const REAL = real.length;
      const CLONES = REAL > 1 ? 2 : 0;
      const cloned: HTMLElement[] = [];
      const addClone = (source: HTMLElement, edge: 'start' | 'end'): void => {
        const clone = source.cloneNode(true) as HTMLElement;
        // Duplicate ids would break the aria-label wiring, and a screen reader
        // reading the reel twice over is noise — the real cards carry it.
        clone.removeAttribute('id');
        clone.setAttribute('aria-hidden', 'true');
        cloned.push(clone);
        track[edge === 'start' ? 'prepend' : 'append'](clone);
      };
      for (let i = 0; i < CLONES; i++) {
        addClone(real[REAL - 1 - i]!, 'start');
        addClone(real[i]!, 'end');
      }

      const slides = Array.from(track.children) as HTMLElement[];
      // Real card n sits at DOM position n + CLONES once the head copies are in.
      const FIRST_REAL = CLONES;
      let index = FIRST_REAL;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      let scrollSyncTimer = 0;

      const nearestIndex = (): number => {
        const mid = track.scrollLeft + track.clientWidth / 2;
        let best = 0;
        let bestGap = Infinity;
        slides.forEach((slide, i) => {
          const gap = Math.abs(slide.offsetLeft + slide.clientWidth / 2 - mid);
          if (gap < bestGap) {
            bestGap = gap;
            best = i;
          }
        });
        return best;
      };

      // Step off the clones and back onto the real card showing the same three
      // images, so the strip can keep travelling in either direction forever.
      const normalize = (): void => {
        const settled =
          index < FIRST_REAL ? index + REAL : index >= FIRST_REAL + REAL ? index - REAL : index;
        if (settled === index) return;
        index = settled;
        render();
        track.scrollTo({ left: leftFor(index), behavior: 'instant' });
      };

      // Scroll offset that puts slide `i` dead centre. Anchoring on offsetLeft
      // instead would park the slide at the LEFT edge while nearestIndex() reads
      // the CENTRED one — the two disagree by a card, which is what made every
      // arrow click advance the strip by two.
      const leftFor = (i: number): number => {
        const slide = slides[i];
        if (!slide) return 0;
        return slide.offsetLeft - (track.clientWidth - slide.offsetWidth) / 2;
      };

      const render = (): void => {
        slides.forEach((slide, n) => slide.classList.toggle('is-active', n === index));
        prev.disabled = false;
        next.disabled = false;
      };

      // `instant`, not `auto`: `auto` defers to the CSS `scroll-behavior:
      // smooth` on the track, so it animates — and overlapping animations are
      // what made the strip skip cards.
      const goToIndex = (next: number, behavior: ScrollBehavior): void => {
        index = next;
        render();
        track.scrollTo({ left: leftFor(index), behavior });
      };

      const navigate = (delta: number): void => {
        // Always leave from a real card: one step from a clone would walk off
        // the end of the strip.
        normalize();
        goToIndex(index + delta, reduced.matches ? 'instant' : 'smooth');
      };

      prev.addEventListener('click', () => navigate(-1), { signal });
      next.addEventListener('click', () => navigate(1), { signal });
      track.addEventListener(
        'keydown',
        (e) => {
          if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
          e.preventDefault();
          navigate(e.key === 'ArrowRight' ? 1 : -1);
        },
        { signal },
      );

      // Manual swipe/trackpad: adopt whatever the scroller settled on. Never
      // scroll back here — the browser's mandatory snap has already landed on a
      // card centre, and re-scrolling would fight it mid-gesture.
      const syncToScroller = (): void => {
        const nearest = nearestIndex();
        if (nearest !== index) {
          index = nearest;
          render();
        }
        normalize();
      };

      track.addEventListener(
        'scroll',
        () => {
          window.clearTimeout(scrollSyncTimer);
          scrollSyncTimer = window.setTimeout(syncToScroller, 120);
        },
        { passive: true, signal },
      );
      track.addEventListener('scrollend', syncToScroller, { signal });

      // Card width is viewport-derived, so every centre moves on resize.
      const ro = new ResizeObserver(() => {
        track.scrollTo({ left: leftFor(index), behavior: 'instant' });
      });
      ro.observe(track);

      // Open on the first real card, not on a head clone.
      goToIndex(FIRST_REAL, 'instant');

      track.__tourCleanup = () => {
        events.abort();
        ro.disconnect();
        for (const clone of cloned) clone.remove();
        window.clearTimeout(scrollSyncTimer);
        track.__tourCleanup = undefined;
      };
    } else {
      // No slides: tear down listeners that may have existed from a prior mount.
      events.abort();
      track.__tourCleanup = undefined;
    }
  }
</script>
