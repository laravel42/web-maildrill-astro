---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/lib/icons';
import { routes } from '@/config/routes';
import {
  organizationJsonLd,
  softwareApplicationJsonLd,
  websiteJsonLd,
} from '@/lib/seo/structured-data';

const seo = {
  title: 'Maildrill — One workspace for email, SMS & WhatsApp campaigns',
  description:
    'Maildrill is the fast, professional workspace for creating, delivering, and analyzing multichannel messaging campaigns across email, SMS, WhatsApp, and voice. 99.2% deliverability, one shared audience.',
};

type Row = {
  num: string;
  icon: IconName;
  title: string;
  href: string;
  desc: string;
  color: string;
  tint: string;
};
const channelRows: Row[] = [
  {
    num: '01',
    icon: 'mail',
    title: 'Email',
    href: routes.channels.email,
    desc: 'Drag-and-drop builder, reusable templates, and inbox-ready HTML that renders everywhere.',
    color: 'var(--ch-email)',
    tint: 'var(--ch-email-tint)',
  },
  {
    num: '02',
    icon: 'sms',
    title: 'SMS',
    href: routes.channels.sms,
    desc: 'Two-way texting with link tracking, opt-out handling, and carrier-grade routing.',
    color: 'var(--ch-sms)',
    tint: 'var(--ch-sms-tint)',
  },
  {
    num: '03',
    icon: 'whatsapp',
    title: 'WhatsApp',
    href: routes.channels.whatsapp,
    desc: 'Approved templates, rich media, and conversation flows on the official Business API.',
    color: 'var(--ch-whatsapp)',
    tint: 'var(--ch-whatsapp-tint)',
  },
  {
    num: '04',
    icon: 'voice',
    title: 'Voice',
    href: routes.channels.voice,
    desc: 'Automated voice calls and IVR flows with text-to-speech, call tracking, and fallbacks.',
    color: 'var(--ch-voice)',
    tint: 'var(--ch-voice-tint)',
  },
];

type Feature = { icon: IconName; title: string; desc: string };
const features: Feature[] = [
  {
    icon: 'bolt',
    title: 'Campaign wizard',
    desc: 'Sender, audience, content, review, schedule — a guided flow with a live preview at every step.',
  },
  {
    icon: 'users',
    title: 'One shared audience',
    desc: 'Lists, subscribers, and live segments shared across every channel. Import once.',
  },
  {
    icon: 'chart',
    title: 'Deep analytics',
    desc: 'Trends, funnels, and per-channel performance — not just a wall of raw numbers.',
  },
  {
    icon: 'layers',
    title: 'Templates & media',
    desc: 'A reusable template gallery and media library keep your brand consistent.',
  },
  {
    icon: 'shield',
    title: 'Deliverability first',
    desc: 'Domain auth, warmup, and reputation monitoring so more messages land in the inbox.',
  },
  {
    icon: 'sparkle',
    title: 'AI copilot',
    desc: 'Draft subject lines, rewrite copy, and generate variants without leaving the editor.',
  },
];

const stats = [
  { to: 99.2, decimals: 1, suffix: '%', prefix: '', label: 'Average deliverability' },
  { to: 2.4, decimals: 1, suffix: 'M', prefix: '', label: 'Messages sent monthly' },
  { to: 1.2, decimals: 1, suffix: 'k+', prefix: '', label: 'Active workspaces' },
  { to: 40, decimals: 0, suffix: '%', prefix: '', label: 'Faster campaign setup' },
];

/**
 * Product screenshots for the tour carousel.
 *
 * These replace three invented testimonials with quotes attributed to people
 * who do not exist — the screenshots are the same product a visitor gets, so
 * they make a claim we can actually stand behind.
 *
 * Intrinsic dimensions are 1600x1000 — captured at 3200 (2x) and halved,
 * which is still above the ~1340px the widest slot renders at. Declared on
 * every <img> so the browser reserves the box before the image arrives and the
 * section does not jump as each one loads.
 */
const shots = [
  { src: '/product/01-dashboard.png', url: 'app.maildrill.net/dashboard', title: 'One workspace, four channels',
    caption: 'Email, SMS, WhatsApp and voice reporting side by side — not four dashboards.' },
  { src: '/product/09-email-builder.png', url: 'app.maildrill.net/templates/email', title: 'Drag-and-drop email builder',
    caption: 'Blocks, live preview and mobile view, on templates your team can reuse.' },
  { src: '/product/10-whatsapp-builder.png', url: 'app.maildrill.net/templates/whatsapp', title: 'WhatsApp templates done properly',
    caption: 'Real components, placeholders and Meta approval states — not a text box.' },
  { src: '/product/02-campaigns.png', url: 'app.maildrill.net/campaigns', title: 'Every campaign, every channel',
    caption: 'Outcomes per send, with failures surfaced instead of buried.' },
  { src: '/product/03-analytics-dark.png', url: 'app.maildrill.net/analytics', title: 'Analytics that state their basis',
    caption: 'Delivery, opens and clicks per channel, each with its window named.' },
  { src: '/product/06-templates.png', url: 'app.maildrill.net/templates', title: 'A template library per channel',
    caption: 'Performance on the card, so you reuse what works.' },
  { src: '/product/04-subscribers.png', url: 'app.maildrill.net/subscribers', title: 'Audiences that stay fast',
    caption: 'Search and filter across a million contacts without waiting.' },
  { src: '/product/05-lists.png', url: 'app.maildrill.net/lists', title: 'Lists with channel consent built in',
    caption: 'Which channels a list may use, and who is reachable on each.' },
  { src: '/product/07-media.png', url: 'app.maildrill.net/media', title: 'Shared media library',
    caption: 'Assets once, reused across every template and channel.' },
  { src: '/product/08-dashboard-dark.png', url: 'app.maildrill.net/dashboard', title: 'Light and dark, everywhere',
    caption: 'Every screen ships in both — including the ones you print.' },
];

const jsonLd = [organizationJsonLd(), websiteJsonLd(), softwareApplicationJsonLd()];
---

<MarketingLayout seo={seo} jsonLd={jsonLd}>
  {/* ---------------------------------------------------------------- HERO */}
  <section class="hero container--wide">
    <div class="hero__glow" aria-hidden="true"></div>
    <p class="eyebrow" data-reveal>Multichannel messaging</p>
    <h1 class="hero__title display" data-reveal style="--reveal-delay:60ms">
      One workspace for every message.
    </h1>
    <div class="hero__intro">
      <div>
        <p class="hero__lead" data-reveal style="--reveal-delay:120ms">
          Create, deliver, and analyze <strong>email, SMS, WhatsApp, and voice</strong> campaigns from
          one fast workspace — one shared audience, deliverability you can trust.
        </p>
        <div class="cta-row" data-reveal style="--reveal-delay:220ms">
          <a
            href={routes.auth.signup}
            class="btn btn--primary btn--pill btn--lg"
            data-magnetic="0.15"
          >
            Start free trial
            <span class="btn__icon btn__icon--arrow" aria-hidden="true">
              <Icon name="arrow-up-right" size={15} stroke={2.2} />
            </span>
          </a>
          <a href={routes.product} class="btn btn--underline">See how it works</a>
        </div>
      </div>
      <dl class="hero__metrics" data-reveal style="--reveal-delay:180ms">
        <div>
          <dt class="mono tnum">99.2%</dt>
          <dd>deliverability</dd>
        </div>
        <div>
          <dt class="mono tnum">4</dt>
          <dd>channels, one audience</dd>
        </div>
        <div>
          <dt class="mono tnum">1.2k+</dt>
          <dd>workspaces</dd>
        </div>
      </dl>
    </div>

    {/* Product frame — recreated in CSS (no screenshot) */}
    <div class="frame" data-reveal data-tilt="4" style="--reveal-delay:120ms">
      <div class="frame__glow frame__glow--indigo" aria-hidden="true"></div>
      <div class="frame__glow frame__glow--orange" aria-hidden="true"></div>
      <div class="frame__inner">
        <div class="mock">
          <div class="mock__chrome">
            <span class="mock__dot"></span><span class="mock__dot"></span><span class="mock__dot"
            ></span>
            <span class="mock__path mono">maildrill / campaigns</span>
          </div>
          <div class="mock__body">
            <div class="mock__head">
              <span class="mock__title">Spring Launch</span>
              <span class="badge badge--success">Sent</span>
            </div>
            <div class="mock__kpis">
              <div class="mock__kpi"><span>Delivered</span><b class="mono tnum">98.4%</b></div>
              <div class="mock__kpi"><span>Opened</span><b class="mono tnum">54.1%</b></div>
              <div class="mock__kpi"><span>Clicked</span><b class="mono tnum">21.7%</b></div>
            </div>
            <div class="mock__chart" aria-hidden="true">
              <span style="height:40%;--d:.30s"></span>
              <span style="height:62%;--d:.38s"></span>
              <span style="height:48%;--d:.46s"></span>
              <span style="height:80%;--d:.54s"></span>
              <span style="height:66%;--d:.62s"></span>
              <span class="mock__chart-accent" style="height:94%;--d:.70s"></span>
            </div>
          </div>
        </div>
        <div class="stack">
          <div class="stack__card stack__card--float">
            <div class="stack__head">
              <span class="stack__ic stack__ic--sms"><Icon name="sms" size={13} /></span><span
                class="mono stack__label stack__label--sms">SMS</span
              >
            </div>
            <p class="stack__msg">Your order shipped 🎉 Track it → mdrl.co/t</p>
          </div>
          <div class="stack__card stack__card--float2">
            <div class="stack__head">
              <span class="stack__ic stack__ic--wa"><Icon name="whatsapp" size={13} /></span><span
                class="mono stack__label stack__label--wa">WhatsApp</span
              >
            </div>
            <p class="stack__msg stack__msg--wa">Appointment confirmed for Tue 10:00 ✅</p>
          </div>
          <div class="stack__card stack__card--drift stack__deliver">
            <svg width="46" height="46" viewBox="0 0 48 48" aria-hidden="true">
              <circle cx="24" cy="24" r="19" fill="none" stroke="var(--divider)" stroke-width="6"
              ></circle>
              <circle
                cx="24"
                cy="24"
                r="19"
                fill="none"
                stroke="var(--ch-whatsapp)"
                stroke-width="6"
                stroke-linecap="round"
                stroke-dasharray="119"
                stroke-dashoffset="4"
                transform="rotate(-90 24 24)"></circle>
            </svg>
            <div>
              <div class="mono tnum stack__deliver-num">99.2%</div><div
                class="stack__deliver-label"
              >
                deliverability
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ CHANNELS */}
  <section class="channels container--wide">
    <div class="channels__head">
      <div>
        <p class="eyebrow" data-reveal>Channels</p>
        <h2 class="h-section" data-reveal style="--reveal-delay:60ms">
          Four channels. One audience.
        </h2>
      </div>
      <a href={`${routes.product}#channels`} class="btn btn--underline">Explore solutions</a>
    </div>
    <div class="channels__list">
      {
        channelRows.map((row, i) => (
          <a href={row.href} class="chrow" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <span class="chrow__num mono">{row.num}</span>
            <div class="chrow__name">
              <span class="chrow__ic" style={`background:${row.tint};color:${row.color}`}>
                <Icon name={row.icon} size={22} />
              </span>
              <span class="chrow__title">{row.title}</span>
            </div>
            <span class="chrow__desc">{row.desc}</span>
            <span class="chrow__arrow" aria-hidden="true">
              <Icon name="arrow-up-right" size={22} stroke={2} />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  {/* ----------------------------------------------------------- WORKSPACE */}
  <section class="workspace">
    <div class="container--wide">
      <p class="eyebrow" data-reveal>Workspace</p>
      <h2 class="h-section workspace__title" data-reveal style="--reveal-delay:60ms">
        Everything a campaign needs. Nothing it doesn't.
      </h2>
      <div class="grid-3">
        {
          features.map((f, i) => (
            <div class="feat" data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
              <span class="feat__ic">
                <Icon name={f.icon} size={22} />
              </span>
              <h3 class="feat__title">{f.title}</h3>
              <p class="feat__desc">{f.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- RESULTS */}
  <section class="results">
    <div class="results__glow results__glow--indigo" aria-hidden="true"></div>
    <div class="results__glow results__glow--orange" aria-hidden="true"></div>
    <div class="container--wide results__inner">
      <p class="eyebrow results__eyebrow" data-reveal>Results</p>
      <h2 class="h-section results__title" data-reveal style="--reveal-delay:60ms">
        Numbers our senders send by.
      </h2>
      <div class="grid-4">
        {
          stats.map((s, i) => (
            <div class="result" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <div
                class="result__num mono tnum"
                data-count
                data-to={s.to}
                data-suffix={s.suffix}
                data-decimals={s.decimals}
                data-prefix={s.prefix}
              >
                {s.prefix}0{s.suffix}
              </div>
              <div class="result__label">{s.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* -------------------------------------------------------------- VOICES */}
  {/* -------------------------------------------------------------- TOUR */}
  <section class="tour container--wide" aria-labelledby="tour-title">
    <p class="eyebrow" data-reveal>Product tour</p>
    <h2 class="h-section tour__title" id="tour-title" data-reveal style="--reveal-delay:60ms">
      See it before you sign up.
    </h2>

    {/* Scroll-snap does the carousel; JS only adds the arrows, dots and
        autoplay on top. With JS unavailable or still parsing, this is a
        horizontally scrollable strip of screenshots that already works. */}
    <div class="tour__frame" data-reveal style="--reveal-delay:120ms">
      <ul class="tour__track" id="tour-track" tabindex="0" role="group" aria-label="Product screenshots, scrollable">
        {
          shots.map((shot, i) => (
            <li class="tour__slide" id={`tour-slide-${i}`} aria-label={`${i + 1} of ${shots.length}: ${shot.title}`}>
              <figure class="tour__fig">
                {/* Browser chrome. Purely decorative and aria-hidden: it
                    frames the screenshot as a real app rather than a floating
                    rectangle, but a screen reader announcing three dots and a
                    fake URL bar before every slide would be noise. The alt
                    text on the image carries the meaning. */}
                <div class="tour__chrome">
                  <span class="tour__lights" aria-hidden="true">
                    <i></i><i></i><i></i>
                  </span>
                  <span class="tour__tab" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="tour__favicon"><path d="M4 6h16v12H4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Maildrill
                  </span>
                  <span class="tour__url" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="tour__lock"><path d="M7 11V8a5 5 0 0110 0v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><rect x="5" y="11" width="14" height="9" rx="2" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                    {shot.url}
                  </span>
                </div>
                <img
                  src={shot.src}
                  alt={shot.title}
                  width="1600"
                  height="1000"
                  decoding="async"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                />
                <figcaption>
                  <strong>{shot.title}</strong>
                  <span>{shot.caption}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>

      <button class="tour__arrow tour__arrow--prev" type="button" data-tour-prev aria-controls="tour-track" aria-label="Previous screenshot" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="tour__arrow tour__arrow--next" type="button" data-tour-next aria-controls="tour-track" aria-label="Next screenshot" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

    <div class="tour__dots" data-tour-dots role="tablist" aria-label="Choose a screenshot" hidden>
      {
        shots.map((shot, i) => (
          <button
            type="button"
            class="tour__dot"
            role="tab"
            aria-controls={`tour-slide-${i}`}
            aria-label={shot.title}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-tour-dot={i}
          />
        ))
      }
    </div>
  </section>
</MarketingLayout>

<style>
  /* ---- HERO ---- */
  .hero {
    position: relative;
    padding-block: 64px 48px;
  }

  .hero__glow {
    position: absolute;
    top: 0;
    right: -40px;
    width: 460px;
    height: 460px;
    max-width: 70vw;
    background: radial-gradient(circle at 40% 40%, rgba(255, 68, 31, 0.1), transparent 62%);
    filter: blur(10px);
    animation: blob 16s ease-in-out infinite;
    pointer-events: none;
  }

  .hero__title {
    font-size: var(--display-hero);
    margin: 18px 0 0;
    max-width: 15ch;
  }

  .hero__intro {
    display: grid;
    gap: 48px;
    align-items: end;
    margin-top: 32px;
  }

  .hero__lead {
    font-size: var(--fs-lg);
    line-height: 1.55;
    color: var(--text3);
    margin: 0;
    max-width: 46ch;
  }

  .hero__lead strong {
    color: var(--text);
    font-weight: 600;
  }

  .hero__metrics {
    display: flex;
    gap: 36px;
    flex-wrap: wrap;
    margin: 0;
  }

  .hero__metrics dt {
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .hero__metrics dd {
    margin: 2px 0 0;
    font-size: var(--fs-sm);
    color: var(--text4);
  }

  @media (min-width: 900px) {
    .hero__intro {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  /* ---- Product frame ---- */
  .frame {
    position: relative;
    margin-top: 56px;
    border-radius: 24px;
    background: linear-gradient(135deg, #201d16, #15130d);
    padding: 14px;
    box-shadow: var(--shadow-float);
    overflow: hidden;
  }

  .frame__glow {
    position: absolute;
    pointer-events: none;
  }

  .frame__glow--indigo {
    top: -40px;
    left: 20%;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(99, 91, 245, 0.28), transparent 65%);
    animation: drift 12s ease-in-out infinite;
  }

  .frame__glow--orange {
    bottom: -60px;
    right: 8%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(255, 68, 31, 0.22), transparent 65%);
    animation: blob 14s ease-in-out infinite;
  }

  .frame__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 14px;
    align-items: stretch;
  }

  @media (max-width: 720px) {
    .frame__inner {
      grid-template-columns: 1fr;
    }
  }

  .mock {
    background: var(--surface);
    border-radius: 14px;
    overflow: hidden;
  }

  .mock__chrome {
    height: 40px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 16px;
    border-bottom: 1px solid var(--divider);
    background: var(--surface3);
  }

  .mock__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border2);
  }

  .mock__path {
    margin-left: 10px;
    font-size: 11px;
    color: var(--muted);
  }

  .mock__body {
    padding: 20px;
  }

  .mock__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .mock__title {
    font-size: 15px;
    font-weight: 600;
  }

  .mock__kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 18px;
  }

  .mock__kpi {
    background: var(--bg);
    border-radius: 10px;
    padding: 12px;
  }

  .mock__kpi span {
    display: block;
    font-size: 11px;
    color: var(--text4);
    margin-bottom: 4px;
  }

  .mock__kpi b {
    font-size: 19px;
    font-weight: 500;
  }

  .mock__chart {
    display: flex;
    align-items: flex-end;
    gap: 7px;
    height: 96px;
  }

  .mock__chart span {
    flex: 1;
    background: linear-gradient(#818cf8, #4f46e5);
    border-radius: 4px 4px 0 0;
    transform-origin: bottom;
    animation: grow 0.9s var(--ease-out) var(--d) both;
  }

  .mock__chart-accent {
    background: linear-gradient(#ff7a5c, #ff441f) !important;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .stack__card {
    background: var(--surface);
    border-radius: 14px;
    padding: 14px;
  }

  .stack__card--float {
    animation: floaty 8s ease-in-out infinite;
  }
  .stack__card--float2 {
    animation: floaty2 9s ease-in-out 0.4s infinite;
  }
  .stack__card--drift {
    animation: drift 10s ease-in-out infinite;
  }

  .stack__head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .stack__ic {
    width: 24px;
    height: 24px;
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stack__ic--sms {
    background: var(--ch-sms-tint);
    color: var(--ch-sms);
  }
  .stack__ic--wa {
    background: var(--ch-whatsapp-tint);
    color: var(--ch-whatsapp);
  }

  .stack__label {
    font-size: 11px;
    font-weight: 600;
  }
  .stack__label--sms {
    color: var(--ch-sms);
  }
  .stack__label--wa {
    color: var(--ch-whatsapp);
  }

  .stack__msg {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--text2);
    background: var(--bg);
    border-radius: 10px;
    padding: 9px 11px;
  }

  .stack__msg--wa {
    background: var(--ch-whatsapp-tint);
    border-radius: 10px 10px 10px 2px;
  }

  .stack__deliver {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .stack__deliver-num {
    font-size: 18px;
    font-weight: 500;
  }

  .stack__deliver-label {
    font-size: 11px;
    color: var(--text4);
  }

  /* ---- CHANNELS ---- */
  .channels {
    padding-block: 88px 40px;
  }

  .channels__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 36px;
  }

  .channels__list {
    border-top: 1px solid var(--border2);
  }

  .chrow {
    display: grid;
    grid-template-columns: 64px 1fr 1.4fr 40px;
    gap: 24px;
    align-items: center;
    padding: 30px 20px;
    border-bottom: 1px solid var(--border2);
    color: inherit;
    transition: background var(--duration) var(--ease-out);
  }

  .chrow:hover {
    background: var(--surface3);
  }

  .chrow__num {
    font-size: 15px;
    color: var(--muted);
  }

  .chrow__name {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .chrow__ic {
    width: 44px;
    height: 44px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .chrow__title {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: color var(--duration) var(--ease-out);
  }

  .chrow:hover .chrow__title {
    color: var(--brand);
  }

  .chrow__desc {
    font-size: var(--fs-md);
    line-height: 1.5;
    color: var(--text3);
  }

  .chrow__arrow {
    color: var(--text);
    opacity: 0.35;
    transition:
      opacity var(--duration-slow) var(--ease-out),
      transform var(--duration-slow) var(--ease-out);
  }

  .chrow:hover .chrow__arrow {
    opacity: 1;
    transform: translate(6px, -6px);
  }

  @media (max-width: 760px) {
    .chrow {
      grid-template-columns: 40px 1fr;
      gap: 10px 16px;
      padding: 22px 4px;
    }
    .chrow__desc {
      grid-column: 2;
      font-size: var(--fs-sm2);
    }
    .chrow__arrow {
      display: none;
    }
    .chrow__title {
      font-size: 22px;
    }
  }

  /* ---- WORKSPACE ---- */
  .workspace {
    background: var(--surface);
    border-block: 1px solid var(--border);
    padding-block: 88px;
  }

  .workspace__title {
    margin: 14px 0 44px;
    max-width: 18ch;
  }

  .feat__ic {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    background: var(--surface2);
    color: var(--accent);
    margin-bottom: 16px;
  }

  .feat__title {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
  }

  .feat__desc {
    font-size: var(--fs-base);
    line-height: 1.6;
    color: var(--text3);
    margin: 0;
  }

  /* ---- RESULTS ---- */
  .results {
    position: relative;
    background: var(--ink-band);
    color: var(--ink-band-text);
    overflow: hidden;
  }

  .results__glow {
    position: absolute;
    pointer-events: none;
  }

  .results__glow--indigo {
    top: -80px;
    right: 6%;
    width: 360px;
    height: 360px;
    background: radial-gradient(circle, rgba(99, 91, 245, 0.24), transparent 65%);
    animation: blob 14s ease-in-out infinite;
  }

  .results__glow--orange {
    bottom: -100px;
    left: 2%;
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(255, 68, 31, 0.18), transparent 65%);
    animation: drift 13s ease-in-out infinite;
  }

  .results__inner {
    position: relative;
    padding-block: 96px;
  }

  .results__eyebrow {
    color: var(--muted);
  }

  .results__title {
    margin: 14px 0 56px;
    max-width: 20ch;
    color: var(--ink-band-text);
  }

  .result {
    border-top: 1px solid var(--ink-band-border);
    padding-top: 20px;
  }

  .result__num {
    font-size: clamp(2.75rem, 5vw, 4.25rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--ink-band-text);
  }

  .result__label {
    font-size: var(--fs-base);
    color: var(--ink-band-text2);
    margin-top: 8px;
  }

  /* ---- VOICES ---- */
  /* ---- PRODUCT TOUR ----
     A scroll-snap carousel. The scroller is the source of truth for "which
     slide is showing" — arrows and dots scroll it rather than tracking their
     own index, so a trackpad swipe, a dot click and an arrow key can never
     disagree about where the carousel is. */
  .tour {
    --tour-gap: 30px;
    padding-block: 88px;
  }
  .tour__title {
    margin: 14px 0 40px;
  }
  .tour__frame {
    position: relative;
  }
  .tour__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-auto-flow: column;
    /* Three across, so the strip reads as a gallery you can scan rather than
       one screenshot at a time. The gap is subtracted before dividing, or the
       third card is pushed past the right edge. */
    grid-auto-columns: calc((100% - 2 * var(--tour-gap)) / 3);
    gap: var(--tour-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    /* The screenshots carry their own shadow, which the scroller would clip. */
    padding-bottom: 10px;
    scrollbar-width: none;
  }
  .tour__track::-webkit-scrollbar {
    display: none;
  }
  .tour__track:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 6px;
    border-radius: 22px;
  }
  /* Centre card foregrounded: the one being read is full size and opaque, its
     neighbours sit back. Done with transform and opacity rather than by giving
     the centre track a wider column — a width change would reflow the whole
     strip on every scroll tick and fight the snap. Scaling leaves layout
     untouched, so the snap positions stay exactly where they were. */
  .tour__slide {
    scroll-snap-align: center;
    min-width: 0;
    transform: scale(0.9);
    opacity: 0.5;
    transition:
      transform 0.32s var(--ease-out, cubic-bezier(0.2, 0.7, 0.3, 1)),
      opacity 0.32s ease;
  }
  .tour__slide.is-active {
    transform: scale(1);
    opacity: 1;
    /* Above its neighbours so the raised card's shadow reads correctly. */
    position: relative;
    z-index: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .tour__slide {
      transition: none;
    }
  }
  .tour__fig {
    margin: 0;
  }
  /* Chrome + screenshot form one window: the border, radius and shadow live on
     the figure so the two pieces share an outline, rather than each carrying
     its own and meeting at a visible seam. */
  .tour__fig {
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 24px 60px rgba(28, 25, 23, 0.14);
  }
  .tour__chrome {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 10px;
    height: 32px;
    background: var(--surface-2, rgba(128, 122, 112, 0.09));
    border-bottom: 1px solid var(--border);
  }
  .tour__lights {
    display: flex;
    gap: 5px;
    flex: none;
  }
  .tour__lights i {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--border);
  }
  /* Tinted, not literal macOS red/amber/green: the frame should read as "an
     app in a browser", not as a screenshot of one specific operating system. */
  .tour__lights i:nth-child(1) {
    background: #ec6a5e;
  }
  .tour__lights i:nth-child(2) {
    background: #f4bf4f;
  }
  .tour__lights i:nth-child(3) {
    background: #61c454;
  }
  .tour__tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex: none;
    max-width: 120px;
    padding: 4px 9px;
    font-size: 11px;
    border-radius: 8px 8px 0 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-bottom: 0;
    margin-bottom: -1px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
  }
  .tour__favicon {
    width: 13px;
    height: 13px;
    flex: none;
    color: var(--brand);
  }
  .tour__url {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex: 1 1 auto;
    min-width: 0;
    height: 20px;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tour__lock {
    width: 11px;
    height: 11px;
    flex: none;
  }
  .tour__fig img {
    display: block;
    width: 100%;
    height: auto;
  }
  .tour__fig figcaption {
    display: block;
    padding: 14px 15px 16px;
    border-top: 1px solid var(--border);
    max-width: 62ch;
  }
  .tour__fig figcaption strong {
    display: block;
    font-size: 14.5px;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .tour__fig figcaption span {
    display: block;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
    /* Two lines for every card, so a short caption and a long one leave the
       row of cards the same height instead of ragged. */
    min-height: 2lh;
  }

  .tour__arrow {
    position: absolute;
    top: 0;
    /* Centred on the IMAGE, not the figure: the caption below would drag the
       arrows off-centre and they would drift as caption lengths differ. */
    height: 68%;
    display: grid;
    place-items: center;
    width: 52px;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .tour__arrow svg {
    width: 22px;
    height: 22px;
    padding: 9px;
    box-sizing: content-box;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 6px 18px rgba(28, 25, 23, 0.16);
  }
  .tour__arrow--prev {
    left: -14px;
  }
  .tour__arrow--next {
    right: -14px;
  }
  .tour__frame:hover .tour__arrow,
  .tour__arrow:focus-visible {
    opacity: 1;
  }
  .tour__arrow[disabled] {
    opacity: 0 !important;
    pointer-events: none;
  }

  .tour__dots {
    display: flex;
    justify-content: center;
    gap: 9px;
    margin-top: 26px;
  }
  .tour__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--border);
    cursor: pointer;
    transition:
      background 0.18s ease,
      width 0.18s ease;
  }
  .tour__dot[aria-selected='true'] {
    width: 26px;
    background: var(--brand);
  }
  .tour__dot:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tour__track {
      scroll-behavior: auto;
    }
  }
  @media (max-width: 1080px) {
    .tour__track {
      grid-auto-columns: calc((100% - var(--tour-gap)) / 2);
    }
  }
  @media (max-width: 720px) {
    .tour {
      padding-block: 64px;
    }
    .tour__track {
      grid-auto-columns: 88%;
    }
    /* Arrows assume a pointer that can hover; touch gets the swipe it already
       has, and the dots stay for position. */
    .tour__arrow {
      display: none;
    }
    /* The tab label is the least load-bearing part of the chrome, and the URL
       is what actually says which screen this is. */
    .tour__tab {
      display: none;
    }
    .tour__chrome {
      height: 36px;
    }
  }
</style>

<script>
  /**
   * Product tour carousel.
   *
   * The scroller is the single source of truth for the current slide — the
   * dots and arrows read it rather than keeping their own index, so a
   * trackpad swipe, a dot click and an arrow key can never disagree about
   * where the carousel is. Both controls are hidden in the markup and
   * revealed here, so no-JS visitors get a plain scrollable strip rather than
   * buttons that do nothing.
   */
  const track = document.getElementById('tour-track');
  const dotsBar = document.querySelector<HTMLElement>('[data-tour-dots]');
  const prev = document.querySelector<HTMLButtonElement>('[data-tour-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-tour-next]');

  if (track && dotsBar && prev && next) {
    const slides = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(dotsBar.querySelectorAll<HTMLButtonElement>('[data-tour-dot]'));
    for (const el of [dotsBar, prev, next]) el.hidden = false;

    /** Index whose centre is nearest the scroller's centre. */
    const current = (): number => {
      const mid = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      let bestGap = Infinity;
      slides.forEach((slide, i) => {
        const gap = Math.abs(slide.offsetLeft + slide.clientWidth / 2 - mid);
        if (gap < bestGap) {
          bestGap = gap;
          best = i;
        }
      });
      return best;
    };

    const goTo = (i: number): void => {
      const slide = slides[Math.max(0, Math.min(slides.length - 1, i))];
      if (slide) track.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
    };

    const sync = (): void => {
      const i = current();
      slides.forEach((slide, n) => slide.classList.toggle('is-active', n === i));
      dots.forEach((dot, n) => dot.setAttribute('aria-selected', n === i ? 'true' : 'false'));
      // Disabled rather than wrapped: an arrow that silently jumps from the
      // last slide back to the first reads as a bug at the edge of a strip
      // the visitor can also see is at its end.
      prev.disabled = i === 0;
      next.disabled = i === slides.length - 1;
    };

    prev.addEventListener('click', () => goTo(current() - 1));
    next.addEventListener('click', () => goTo(current() + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    track.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      goTo(current() + (e.key === 'ArrowRight' ? 1 : -1));
    });

    // Throttled to animation frames: scroll fires far more often than the
    // dots can usefully change.
    let queued = false;
    track.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          sync();
        });
      },
      { passive: true },
    );
    sync();

    /**
     * Autoplay, but only when it cannot annoy: paused on hover, on keyboard
     * focus, when the section is off-screen, and skipped entirely for anyone
     * who asked for reduced motion. It also stops for good on the first
     * manual interaction — once a visitor is driving, moving the carousel
     * under them is hostile.
     */
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer = 0;
    let stopped = false;
    const stop = (): void => {
      window.clearInterval(timer);
      timer = 0;
    };
    const start = (): void => {
      if (stopped || timer || reduced.matches) return;
      timer = window.setInterval(() => {
        const i = current();
        goTo(i >= slides.length - 1 ? 0 : i + 1);
      }, 5200);
    };
    const stopForever = (): void => {
      stopped = true;
      stop();
    };
    for (const evt of ['pointerdown', 'keydown'] as const) {
      track.addEventListener(evt, stopForever, { once: true });
    }
    [prev, next, ...dots].forEach((el) => el.addEventListener('click', stopForever, { once: true }));

    const frame = track.closest('.tour__frame');
    frame?.addEventListener('pointerenter', stop);
    frame?.addEventListener('pointerleave', start);
    track.addEventListener('focusin', stop);
    track.addEventListener('focusout', start);

    new IntersectionObserver(
      ([entry]) => (entry?.isIntersecting ? start() : stop()),
      { threshold: 0.4 },
    ).observe(track);
  }
</script>
