  .results__inner {
    position: relative;
    padding-block: calc(96px * var(--sec-y));
  }

  .results__eyebrow {
    color: var(--muted);
  }

  .results__title {
    margin: 14px 0 56px;
    max-width: 20ch;
    color: var(--ink-band-text);
