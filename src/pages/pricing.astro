---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import PricingEstimator from '@/components/react/PricingEstimator';
import {
  COMPARISON,
  COMPARISON_TOOLS,
  EMAIL_RATE,
  includedItems,
  isPromoActive,
  pricingFaqs,
  REGION_TIERS,
} from '@/config/pricing';
import { breadcrumbJsonLd, faqPageJsonLd, productJsonLd } from '@/lib/seo/structured-data';
import { routes } from '@/config/routes';

const seo = {
  title: 'Pricing — pay-per-use messaging, no monthly minimums',
  description:
    'Maildrill pay-per-use pricing: pay only for the messages you send across email, SMS, WhatsApp, and voice, plus a one-time setup fee per channel. No monthly minimums, no seat charges.',
};

// Evaluated at build time so the server-rendered HTML and client hydration
// agree (no date-driven hydration mismatch). Rebuild after the promo end date
// to fall back to the regular tiers.
const promoActive = isPromoActive();

const jsonLd = [
  productJsonLd({
    name: 'Maildrill pay-per-use messaging',
    description: seo.description,
    path: routes.pricing,
  }),
  faqPageJsonLd([...pricingFaqs]),
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Pricing', path: routes.pricing },
  ]),
];
---

<MarketingLayout seo={seo} jsonLd={jsonLd} active="pricing">
  {/* ---------------- hero ---------------- */}
  <section class="phero container--wide">
    <p class="eyebrow" data-reveal>Pricing</p>
    <h1 class="phero__title display" data-reveal style="--reveal-delay:60ms">
      Pay only for what you send.
    </h1>
    <p class="phero__lead" data-reveal style="--reveal-delay:120ms">
      No plans, no monthly minimums, no seat charges. Every account gets the full workspace — you
      pay a simple per-message rate for each channel, plus a one-time setup fee to activate it.
    </p>
  </section>

  {/* ---------------- interactive calculator (rate cards + estimator + prepay) ---------------- */}
  <PricingEstimator client:visible promoActive={promoActive} />

  {/* ---------------- how we compare ---------------- */}
  <section class="pcmp container--wide" aria-label="How Maildrill compares">
    <p class="eyebrow" data-reveal>How we compare</p>
    <h2 class="h-section pcmp__title" data-reveal style="--reveal-delay:60ms">
      One platform, every channel, no hidden fees.
    </h2>
    <p class="pcmp__intro" data-reveal style="--reveal-delay:120ms">
      Representative US-market list prices. Every rate is all-in — no per-number rentals, no carrier
      surcharges — across one workspace instead of separate SMS, email, and WhatsApp products.
    </p>
    <div class="pcmp__scroll" data-reveal>
      <table class="pcmp__table">
        <thead>
          <tr>
            <th scope="col">Rate · US</th>
            {
              COMPARISON_TOOLS.map((tool, i) => (
                <th scope="col" class:list={['pcmp__tool', i === 0 && 'pcmp__tool--us']}>
                  {tool}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            COMPARISON.map((row) => (
              <tr>
                <th scope="row" class="pcmp__ch">
                  {row.channel}
                  <span class="pcmp__unit">{row.unit}</span>
                </th>
                {COMPARISON_TOOLS.map((tool, i) => (
                  <td class:list={['mono', i === 0 ? 'pcmp__us' : 'pcmp__rival']}>
                    {row.prices[tool]}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="pcmp__sources">
      “—” means the tool doesn’t offer that channel natively. <span class="mono">*</span> All-in estimate:
      Twilio and Telnyx advertise a lower base SMS rate but add per-carrier surcharges ($0.003–0.015/msg)
      on top, so the figure shown folds in a typical surcharge — Maildrill’s rate is genuinely all-in.
      Sources: <a href="https://www.twilio.com/en-us/sms/pricing/us">Twilio</a>,
      <a href="https://sinch.com/pricing/sms/">Sinch</a>,
      <a href="https://www.vonage.com/communications-apis/sms/pricing/">Vonage</a>,
      <a href="https://www.brevo.com/pricing/">Brevo</a>,
      <a href="https://telnyx.com/pricing/messaging">Telnyx</a>, and
      <a href="https://developers.facebook.com/documentation/business-messaging/whatsapp/pricing"
        >Meta WhatsApp rates</a
      > (mid-2026). Indicative — check each provider for your volumes.
    </p>
  </section>

  {/* ---------------- regional tiers ---------------- */}
  <section class="ptier container--wide" aria-label="Regional pricing tiers">
    <p class="eyebrow" data-reveal>Simple regional pricing</p>
    <h2 class="h-section ptier__title" data-reveal style="--reveal-delay:60ms">
      Four tiers. No 200-row rate card.
    </h2>
    <p class="ptier__intro" data-reveal style="--reveal-delay:120ms">
      SMS, WhatsApp, and voice are priced by region — pick your destination in the estimator above
      for the exact rate. Email is a single flat rate worldwide.
    </p>
    <div class="ptier__scroll" data-reveal>
      <table class="ptier__table">
        <thead>
          <tr>
            <th scope="col">Tier</th>
            <th scope="col">Email</th>
            <th scope="col">SMS</th>
            <th scope="col">WhatsApp</th>
            <th scope="col">Voice</th>
          </tr>
        </thead>
        <tbody>
          {
            REGION_TIERS.map((t) => (
              <tr>
                <th scope="row" class="ptier__region">
                  {t.name}
                  <span class="ptier__blurb">{t.blurb}</span>
                </th>
                <td class="mono">${EMAIL_RATE.toFixed(4)}</td>
                <td class="mono">${t.sms.toFixed(4)}</td>
                <td class="mono">${t.whatsapp.toFixed(3)}</td>
                <td class="mono">${t.voice.toFixed(4)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="ptier__note">
      Per-unit list prices in USD. WhatsApp is the Meta marketing-message rate plus a slim platform
      fee. Rates are indicative; your invoice uses the exact destination rate at send time.
    </p>
  </section>

  {/* ---------------- always included ---------------- */}
  <section class="pincl container--wide">
    <p class="eyebrow" data-reveal>Always included</p>
    <h2 class="h-section pincl__title" data-reveal style="--reveal-delay:60ms">
      The whole workspace, on every account.
    </h2>
    <ul class="pincl__grid">
      {
        includedItems.map((item, i) => (
          <li class="pincl__item" data-reveal style={`--reveal-delay:${(i % 3) * 60}ms`}>
            <span class="pincl__check" aria-hidden="true">
              <Icon name="check" size={18} stroke={2.5} />
            </span>
            {item}
          </li>
        ))
      }
    </ul>
  </section>

  {/* ---------------- FAQ ---------------- */}
  <section class="pfaq container--narrow">
    <h2 class="pfaq__title" data-reveal>Frequently asked</h2>
    <div class="pfaq__list">
      {
        pricingFaqs.map((faq) => (
          <details class="pfaq__item" data-reveal>
            <summary>
              {faq.question}
              <span class="pfaq__marker" aria-hidden="true">
                +
              </span>
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </section>
</MarketingLayout>

<style>
  .phero {
    padding-block: 72px 40px;
  }

  .phero__title {
    font-size: var(--display-xl);
    margin: 16px 0 0;
    max-width: 15ch;
  }

  .phero__lead {
    font-size: var(--fs-lg);
    line-height: 1.55;
    color: var(--text3);
    max-width: 56ch;
    margin: 24px 0 0;
  }

  /* how we compare */
  .pcmp {
    padding-block: 72px 24px;
  }

  .pcmp__title {
    margin: 14px 0 0;
    max-width: 20ch;
  }

  .pcmp__intro,
  .ptier__intro {
    font-size: var(--fs-base);
    line-height: 1.55;
    color: var(--text3);
    max-width: 62ch;
    margin: 16px 0 32px;
  }

  .pcmp__scroll,
  .ptier__scroll {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .pcmp__table,
  .ptier__table {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
    font-size: var(--fs-sm2);
  }

  /* 7 columns (Rate + 6 tools) need more room before horizontal scroll. */
  .pcmp__table {
    min-width: 840px;
  }

  .pcmp__table th,
  .pcmp__table td,
  .ptier__table th,
  .ptier__table td {
    text-align: left;
    padding: 15px 18px;
    border-bottom: 1px solid var(--divider);
    vertical-align: top;
  }

  .pcmp__table thead th,
  .ptier__table thead th {
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }

  .pcmp__table tbody tr:last-child th,
  .pcmp__table tbody tr:last-child td,
  .ptier__table tbody tr:last-child th,
  .ptier__table tbody tr:last-child td {
    border-bottom: 0;
  }

  .pcmp__ch,
  .ptier__region {
    font-weight: 600;
    color: var(--text);
  }

  .pcmp__unit,
  .ptier__blurb {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 400;
    color: var(--text4);
    margin-top: 3px;
  }

  /* Tool column headers */
  .pcmp__tool {
    font-size: var(--fs-sm2) !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
    color: var(--text) !important;
    font-weight: 600 !important;
    white-space: nowrap;
  }

  /* Highlight the Maildrill column (header + cells) */
  .pcmp__tool--us,
  .pcmp__us {
    background: var(--success-bg);
  }

  .pcmp__tool--us {
    color: var(--success-strong) !important;
    border-radius: 10px 10px 0 0;
  }

  .pcmp__us {
    font-size: 16px;
    font-weight: 600;
    color: var(--success);
    white-space: nowrap;
  }

  .pcmp__rival {
    color: var(--text3);
    white-space: nowrap;
  }

  .pcmp__sources,
  .ptier__note {
    font-size: var(--fs-xs);
    color: var(--text4);
    line-height: 1.6;
    margin: 16px 0 0;
  }

  .pcmp__sources a {
    color: var(--accent);
    font-weight: 500;
  }

  /* regional tiers */
  .ptier {
    padding-block: 56px 24px;
  }

  .ptier__title {
    margin: 14px 0 0;
    max-width: 24ch;
  }

  .ptier__table td {
    color: var(--text);
    font-size: 15px;
  }

  .pincl {
    padding-block: 72px 40px;
  }

  .pincl__title {
    margin: 14px 0 40px;
    max-width: 18ch;
  }

  .pincl__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px 32px;
  }

  .pincl__item {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    padding: 14px 0;
    border-top: 1px solid var(--border2);
    font-size: var(--fs-base);
    color: var(--text);
  }

  .pincl__check {
    color: var(--success);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .pfaq {
    padding-block: 56px 88px;
  }

  .pfaq__title {
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    letter-spacing: -0.03em;
    font-weight: 800;
    margin: 0 0 32px;
    text-align: center;
  }

  .pfaq__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pfaq__item {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px 22px;
  }

  .pfaq__item summary {
    font-size: var(--fs-md);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .pfaq__item summary::-webkit-details-marker {
    display: none;
  }

  .pfaq__marker {
    color: var(--muted);
    font-size: 20px;
    font-weight: 400;
    transition: transform var(--duration) var(--ease-out);
  }

  .pfaq__item[open] .pfaq__marker {
    transform: rotate(45deg);
  }

  .pfaq__item p {
    font-size: var(--fs-sm2);
    line-height: 1.6;
    color: var(--text3);
    margin: 12px 0 0;
  }

  @media (max-width: 800px) {
    .pincl__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px 24px;
    }
  }

  @media (max-width: 520px) {
    .pincl__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
