---
import AuthLayout from '@/layouts/AuthLayout.astro';
import AuthForm from '@/components/react/AuthForm';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/lib/icons';

const seo = {
  title: 'Reset password',
  description: "Reset your Maildrill password. We'll email you a secure link to set a new one.",
  noindex: true,
};

const notes: { icon: IconName; t: string }[] = [
  { icon: 'shield', t: 'Reset links expire in 30 minutes' },
  { icon: 'check', t: '2FA & SSO keep sessions protected' },
  { icon: 'clock', t: 'Enterprise-grade encryption' },
];
---

<AuthLayout
  seo={seo}
  panelEyebrow="Secure by default"
  panelHeading={'Your workspace, <span style="color:#ff441f">locked down</span>.'}
>
  <AuthForm client:load mode="forgot" />

  <div slot="panel" class="fpanel">
    <ul class="fpanel__notes">
      {
        notes.map((n) => (
          <li>
            <span class="fpanel__ic">
              <Icon name={n.icon} size={16} />
            </span>
            {n.t}
          </li>
        ))
      }
    </ul>
  </div>
</AuthLayout>

<style is:global>
  .fpanel__notes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .fpanel__notes li {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .fpanel__ic {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #ff8f79;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
