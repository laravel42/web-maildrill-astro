---
export const prerender = false;
import AppLayout from '@/layouts/AppLayout.astro';
import AppAnalytics from '@/components/react/AppAnalytics';

// Data loads client-side through the shared dashboard cache (AppAnalytics),
// so navigating here never blocks on PostHog/Postgres. The island shows
// skeletons while booting and serves a fresh 30-minute cache instantly.
const session = Astro.locals.session;
const live = Boolean(session?.user?.id && session.activeTenantId);
---

<AppLayout title="Analytics">
  <AppAnalytics client:load live={live} />
</AppLayout>
