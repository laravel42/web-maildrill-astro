---
export const prerender = false;
import AppLayout from '@/layouts/AppLayout.astro';
import AppDashboard from '@/components/react/AppDashboard';

/* Aggregates load client-side so navigating here isn't blocked on PostHog/PG. */
const session = Astro.locals.session;
const live = Boolean(session?.user?.id && session.activeTenantId);

const hour = Number(
  new Intl.DateTimeFormat('en-US', { hour: 'numeric', hour12: false, timeZone: 'UTC' }).format(
    new Date(),
  ),
);
const greeting = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
---

<AppLayout title="Dashboard">
  <AppDashboard client:load greeting={greeting} live={live} />
</AppLayout>
