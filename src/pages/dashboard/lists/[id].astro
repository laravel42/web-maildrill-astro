---
export const prerender = false;
import AppLayout from '@/layouts/AppLayout.astro';
import AppListDetail from '@/components/react/AppListDetail';
import { productClient, mintServiceToken, serviceBaseUrl } from '@/lib/server/service';
import type { ApiList } from '@/lib/app/list-map';
import type { ApiCampaign } from '@/lib/app/campaign-map';
import type { ApiCustomFieldDef, ApiListStats, ApiSegment } from '@/lib/app/list-detail';
import { routes } from '@/config/routes';

const id = Astro.params.id;
if (!id) {
  return Astro.redirect(routes.app.lists);
}

const session = Astro.locals.session;
if (!session?.user?.id || !session.activeTenantId) {
  return Astro.redirect(routes.auth.login);
}

const ctx = {
  userId: session.user.id,
  activeTenantId: session.activeTenantId,
  role: session.role,
};
const client = productClient(ctx);
const token = mintServiceToken(ctx);
const base = serviceBaseUrl();

const unwrap = <T,>(d: unknown): T[] => (d as { data?: T[] } | undefined)?.data ?? [];

/* One list, measured server-side: /v1/lists/{id}/stats carries the health
   card's counters (memberCount, trend, added7s, delivered/opened/clicked), the
   per-channel send totals across every campaign this list ever ran, AND the
   three rollups over the whole membership the page draws from — the status
   partition, joins per week, and per-custom-field fill. So the page neither
   aggregates the workspace to read one row, nor sums a truncated campaign page
   in the browser, nor describes a 2,000-member list from the 1,000 members it
   could fit in one request. The name map for the import picker is the bounded
   name/colour projection, not the aggregation. */
const [statsRes, listsRes, campaignsRes, segmentsRes, fieldsRes] = await Promise.all([
  client.GET('/v1/lists/{id}/stats', { params: { path: { id } } }),
  /* KNOWN DEFECT (audit #37, minor): a hard cap under the workspace's own size
     — the tenant has 1,006 lists, so 6 are unreachable in this picker. It is a
     bounded sample presented as the whole set, with no "more" affordance. */
  client.GET('/v1/lists', { params: { query: { options: '1', limit: 1000 } } }),
  client.GET('/v1/campaigns', {
    params: { query: { listId: id, limit: 50, sort: 'updatedAt' as const, dir: 'desc' as const } },
  }),
  client.GET('/v1/segments'),
  fetch(`${base}/v1/custom-fields`, {
    headers: { Authorization: `Bearer ${token}` },
  }),
]);

const list = statsRes.data as unknown as ApiListStats | undefined;
if (statsRes.error || !list) {
  return Astro.redirect(routes.app.lists);
}

// ?listId= is a SQL filter now, so this is the list's campaigns rather than
// every campaign in the workspace minus the ones that aren't.
const campaigns =
  (campaignsRes.data as unknown as { items?: ApiCampaign[] } | undefined)?.items ?? [];
const segments = unwrap<ApiSegment>(segmentsRes.data);

let fields: ApiCustomFieldDef[] = [];
if (fieldsRes.ok) {
  try {
    fields = ((await fieldsRes.json()) as { data?: ApiCustomFieldDef[] }).data ?? [];
  } catch {
    fields = [];
  }
}
---

<AppLayout
  title={list.name}
  crumbs={[{ label: 'Lists', href: routes.app.lists }, { label: list.name }]}
>
  <AppListDetail
    client:visible
    initial={list}
    campaigns={campaigns}
    segments={segments}
    fields={fields}
    lists={unwrap<ApiList>(listsRes.data).map((l) => ({ id: l.id, name: l.name }))}
  />
</AppLayout>
