---
export const prerender = false;
import AppLayout from '@/layouts/AppLayout.astro';
import AppSubscriberDetail from '@/components/react/AppSubscriberDetail';
import { productClient, mintServiceToken, serviceBaseUrl } from '@/lib/server/service';
import { toRichSubscriber, type ApiSubscriber } from '@/lib/app/subscriber-map';
import type { ApiSubscriberActivity } from '@/lib/app/subscriber-detail';
import { routes } from '@/config/routes';

const id = Astro.params.id;
if (!id) {
  return Astro.redirect(routes.app.subscribers);
}

const session = Astro.locals.session;
if (!session?.user?.id || !session.activeTenantId) {
  return Astro.redirect(routes.auth.login);
}

const ctx = {
  userId: session.user.id,
  activeTenantId: session.activeTenantId,
  role: session.role,
};
const client = productClient(ctx);
const token = mintServiceToken(ctx);
const base = serviceBaseUrl();

const [subRes, activityRes, listsRes] = await Promise.all([
  client.GET('/v1/subscribers/{id}', { params: { path: { id } } }),
  fetch(`${base}/v1/subscribers/${id}/activity`, {
    headers: { Authorization: `Bearer ${token}` },
  }),
  client.GET('/v1/lists'),
]);

if (subRes.error || !subRes.data) {
  return Astro.redirect(routes.app.subscribers);
}

const apiSub = subRes.data as ApiSubscriber;
const subscriber = toRichSubscriber(apiSub);
const attributes = (apiSub.attributes ?? {}) as Record<string, unknown>;

let activity: ApiSubscriberActivity | null = null;
if (activityRes.ok) {
  try {
    activity = (await activityRes.json()) as ApiSubscriberActivity;
  } catch {
    activity = null;
  }
}

const allLists = (
  (listsRes.data as { data?: { id: string; name: string; color?: string | null }[] } | undefined)
    ?.data ?? []
).map((l) => ({ id: l.id, name: l.name, color: l.color ?? null }));

const title = subscriber.name || subscriber.email;
---

<AppLayout title={title}>
  <AppSubscriberDetail
    client:visible
    initial={subscriber}
    attributes={attributes}
    activity={activity}
    allLists={allLists}
  />
</AppLayout>
