---
export const prerender = false;
import AppLayout from '@/layouts/AppLayout.astro';
import AppCampaignReport from '@/components/react/AppCampaignReport';
import { productClient } from '@/lib/server/service';
import { toCampaign, toCampaigns, type ApiCampaign } from '@/lib/app/campaign-map';
import type { ApiList } from '@/lib/app/list-map';
import type { Campaign } from '@/types/app';
import { routes } from '@/config/routes';

const id = Astro.params.id;
if (!id) {
  return Astro.redirect(routes.app.campaigns);
}

const unwrap = <T,>(d: unknown): T[] => (d as { data?: T[] } | undefined)?.data ?? [];

// Live workspace: fetch the campaign (redirecting home if it's gone), the full
// campaign list for same-channel history sparks, and the lists for the target
// list's colour. No connected workspace = demo mode; the island falls back to
// the fixture campaigns.
const session = Astro.locals.session;
let initial: Campaign | null = null;
let campaigns: Campaign[] | null = null;
let listColor: string | null = null;

if (session?.user?.id && session.activeTenantId) {
  const client = productClient({
    userId: session.user.id,
    activeTenantId: session.activeTenantId,
    role: session.role,
  });
  try {
    const [campaignRes, campaignsRes, listsRes] = await Promise.all([
      client.GET('/v1/campaigns/{id}', { params: { path: { id } } }),
      client.GET('/v1/campaigns'),
      client.GET('/v1/lists'),
    ]);
    if (campaignRes.error || !campaignRes.data) {
      return Astro.redirect(routes.app.campaigns);
    }
    const apiCampaign = campaignRes.data as unknown as ApiCampaign;
    initial = toCampaign(apiCampaign);
    campaigns = toCampaigns(unwrap<ApiCampaign>(campaignsRes.data));
    if (apiCampaign.listId) {
      listColor =
        unwrap<ApiList>(listsRes.data).find((l) => l.id === apiCampaign.listId)?.color ?? null;
    }
  } catch {
    return Astro.redirect(routes.app.campaigns);
  }
}
---

<AppLayout title={initial ? `${initial.name} · Report` : 'Campaign report'}>
  <AppCampaignReport
    client:visible
    id={id}
    initial={initial}
    campaigns={campaigns}
    listColor={listColor}
    live={initial !== null}
  />
</AppLayout>
