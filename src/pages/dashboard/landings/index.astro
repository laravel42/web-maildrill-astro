---
export const prerender = false;
import AppLayout from '@/layouts/AppLayout.astro';
import AppLandings from '@/components/react/AppLandings';
import { productClient } from '@/lib/server/service';
import type { LandingSummary } from '@/lib/app/landings';

/*
 * SSR the first page so the table is painted before hydration — same pattern as
 * Automations and Campaigns. `undefined` means the backend was unreachable,
 * which the island renders as a retryable banner rather than as "no landings".
 */
const session = Astro.locals.session;
let initial: LandingSummary[] | undefined = undefined;
let initialTotal = 0;
let banner: string | null = null;

if (session?.user?.id && session.activeTenantId) {
  try {
    const client = productClient({
      userId: session.user.id,
      activeTenantId: session.activeTenantId,
      role: session.role,
    });
    const { data, error } = await client.GET(
      '/v1/landings' as never,
      {
        params: { query: { limit: 25, sort: 'updatedAt', dir: 'desc' } },
      } as never,
    );
    if (error) {
      banner = 'The landings service returned an error.';
    } else {
      const page = data as unknown as { items?: LandingSummary[]; total?: number };
      initial = page.items ?? [];
      initialTotal = page.total ?? 0;
    }
  } catch (err) {
    banner = err instanceof Error ? err.message : 'Service unreachable.';
  }
}
---

<AppLayout title="Landings">
  {banner && <div class="svc-banner err">{banner}</div>}
  <AppLandings client:visible initial={initial} initialTotal={initialTotal} />
</AppLayout>

<style>
  .svc-banner {
    margin: 0 0 14px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12.5px;
  }
  .svc-banner.err {
    border: 1px solid var(--danger);
    background: var(--danger-bg);
    color: var(--danger-strong);
  }
</style>
