---
export const prerender = false;
import AppLayout from '@/layouts/AppLayout.astro';
import AppLists from '@/components/react/AppLists';
import { productClient } from '@/lib/server/service';
import { toListRows, type ApiList } from '@/lib/app/list-map';
import type { ListRow } from '@/components/react/AppLists.types';
import type { ListFacets } from '@/components/react/AppLists';
import { PAGE_SIZE } from '@/components/react/shared/pagination';

// Load real lists for the signed-in workspace; undefined = not connected (island
// falls back to fixtures), an array = live data (even if empty).
const session = Astro.locals.session;
let initial: ListRow[] | undefined = undefined;
let initialTotal = 0;
let initialFacets: ListFacets | undefined = undefined;
let banner: { ok: boolean; text: string } | null = null;

if (session?.user?.id && session.activeTenantId) {
  try {
    const client = productClient({
      userId: session.user.id,
      activeTenantId: session.activeTenantId,
      role: session.role,
    });
    /* The board opens on the email tab, newest first — so SSR fetches exactly
       that page and the facets behind the tabs and the tag menu, not every list
       in the workspace with a membership aggregate attached to each. */
    const [pageRes, facetsRes] = await Promise.all([
      client.GET('/v1/lists', {
        params: {
          query: {
            limit: PAGE_SIZE,
            channel: 'email' as const,
            sort: 'updatedAt' as const,
            dir: 'desc' as const,
            withTotal: '1',
          },
        },
      }),
      client.GET('/v1/lists/facets'),
    ]);
    if (pageRes.error) {
      banner = { ok: false, text: 'workers returned an error.' };
    } else {
      const body = pageRes.data as unknown as { items?: ApiList[]; total?: number } | undefined;
      initial = toListRows(body?.items ?? []);
      initialTotal = body?.total ?? 0;
      initialFacets = (facetsRes.data as unknown as ListFacets | undefined) ?? undefined;
    }
  } catch (err) {
    banner = { ok: false, text: err instanceof Error ? err.message : 'Service unreachable.' };
  }
}
---

<AppLayout title="Lists">
  {banner && <div class={`svc-banner ${banner.ok ? 'ok' : 'err'}`}>{banner.text}</div>}
  <AppLists
    client:visible
    initial={initial}
    initialTotal={initialTotal}
    initialFacets={initialFacets}
  />
</AppLayout>

<style>
  .svc-banner {
    margin: 0 0 14px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12.5px;
  }
  .svc-banner.ok {
    border: 1px solid #16a34a;
    background: #f0fdf4;
    color: #166534;
  }
  .svc-banner.err {
    border: 1px solid #dc2626;
    background: #fef2f2;
    color: #991b1b;
  }
</style>
