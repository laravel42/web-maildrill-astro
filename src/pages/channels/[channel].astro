---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/lib/icons';
import { routes } from '@/config/routes';
import { serviceJsonLd, breadcrumbJsonLd } from '@/lib/seo/structured-data';
import {
  channelOrder,
  channelPages,
  channelSteps,
  otherChannels,
  type ChannelPageKey,
  type ChannelStat,
} from '@/config/channel-pages';

export function getStaticPaths() {
  return channelOrder.map((key) => ({
    params: { channel: key },
    props: { channelKey: key },
  }));
}

const { channelKey } = Astro.props as { channelKey: ChannelPageKey };
const data = channelPages[channelKey];
const others = otherChannels(channelKey);

const seo = {
  title: data.seo.title,
  description: data.seo.description,
};

const jsonLd = [
  serviceJsonLd({
    name: `Maildrill ${data.label}`,
    description: data.seo.description,
    path: data.href,
  }),
  breadcrumbJsonLd([
    { name: 'Home', path: routes.home },
    { name: 'Channels', path: `${routes.product}#channels` },
    { name: data.label, path: data.href },
  ]),
];

// Channel accent driven from CSS custom properties on the page root.
const chVars = `--cc:${data.color};--ct:${data.tint};--cg:${data.glow}`;

// Format a stat to its final visible value (e.g. "99.2%", "<0.1%", "60+").
const fmt = (s: ChannelStat) => `${s.prefix}${s.to.toFixed(s.decimals)}${s.suffix}`;

// `wizard` is not in the shared icon set — inline it where features reference it.
const wizardPath =
  '<path d="m3 21 11-11"/><path d="m14 6.5 3.5-3.5 3.5 3.5-3.5 3.5z"/><path d="M12 3v2M4 12h1.5M20 15h1.5"/>';

// Voice hero equalizer bar heights (px).
const eqBars = [8, 15, 11, 20, 9, 17, 13, 22, 10];
---

<MarketingLayout seo={seo} jsonLd={jsonLd} active="channels">
  <div class="ch" style={chVars}>
    {/* --------------------------------------------------------------- HERO */}
    <section class="ch-hero container--wide">
      <div class="ch-hero__glow" aria-hidden="true"></div>
      <a href={`${routes.product}#channels`} class="ch-back">
        <span aria-hidden="true">←</span> All channels
      </a>
      <div class="ch-hero__grid">
        <div class="ch-hero__copy">
          <span class="ch-pill" data-reveal>
            <Icon name={data.icon} size={16} stroke={2} />
            {data.label}
          </span>
          <h1 class="ch-hero__title" data-reveal style="--reveal-delay:60ms">{data.h1}</h1>
          <p class="ch-hero__sub" data-reveal style="--reveal-delay:120ms">{data.sub}</p>
          <div class="cta-row" data-reveal style="--reveal-delay:200ms">
            <a href={routes.auth.signup} class="btn btn--primary btn--pill btn--lg ch-cta">
              Start free trial
              <span class="btn__icon btn__icon--arrow" aria-hidden="true">
                <Icon name="arrow-up-right" size={15} stroke={2.2} />
              </span>
            </a>
            <a href={routes.pricing} class="btn btn--underline">See pricing</a>
          </div>
        </div>

        <div class="ch-hero__visual" data-reveal style="--reveal-delay:140ms">
          {/* ---- EMAIL device mock ---- */}
          {
            data.visual === 'email' && (
              <div class="mk mk--float mk-email">
                <div class="mk-email__bar">
                  <>
                    <span class="mk__dot" />
                    <span class="mk__dot" />
                    <span class="mk__dot" />
                  </>
                  <span class="mono mk-email__tab">inbox</span>
                </div>
                <div class="mk-email__body">
                  <div class="mk-email__from">
                    <span class="mk-email__avatar">M</span>
                    <span>
                      <span class="mk-email__name">Maildrill</span>
                      <span class="mk-email__to">to you</span>
                    </span>
                  </div>
                  <div class="mk-email__subject">Your spring collection has landed 🌿</div>
                  <div class="mk-email__hero" aria-hidden="true">
                    Hero image
                  </div>
                  <div class="mk-email__line" style="width:90%" />
                  <div class="mk-email__line" style="width:68%" />
                  <span class="mk-email__btn">Shop now</span>
                </div>
              </div>
            )
          }

          {/* ---- SMS chat mock ---- */}
          {
            data.visual === 'sms' && (
              <div class="mk mk--float mk-sms">
                <div class="mk-sms__bubble mk-sms__bubble--in" style="--pop:0s">
                  Hey Maya! Your cart's still waiting 🛒 Complete your order &amp; get 10% off:
                  mdrl.co/x
                </div>
                <div class="mk-sms__bubble mk-sms__bubble--out" style="--pop:.4s">
                  YES please 🙌
                </div>
                <div class="mk-sms__bubble mk-sms__bubble--in" style="--pop:.8s">
                  Done! Discount applied ✅ See you soon.
                </div>
              </div>
            )
          }

          {/* ---- WhatsApp mock ---- */}
          {
            data.visual === 'whatsapp' && (
              <div class="mk mk--float mk-wa">
                <div class="mk-wa__head">
                  <span class="mk-wa__avatar">M</span>
                  <span>
                    <span class="mk-wa__name">Maildrill</span>
                    <span class="mk-wa__status">● online</span>
                  </span>
                </div>
                <div class="mk-wa__card">
                  <div class="mk-wa__preview" aria-hidden="true">
                    Order preview
                  </div>
                  <div class="mk-wa__title">Your order is confirmed ✅</div>
                  <div class="mk-wa__body">Arriving Tue, Jul 21. Track anytime below.</div>
                  <div class="mk-wa__btns">
                    <span class="mk-wa__btn mk-wa__btn--primary">Track order</span>
                    <span class="mk-wa__btn">Get help</span>
                  </div>
                </div>
              </div>
            )
          }

          {/* ---- Voice mock ---- */}
          {
            data.visual === 'voice' && (
              <div class="mk mk--float mk-voice">
                <div class="mk-voice__row">
                  <span class="mk-voice__ic">
                    <Icon name="voice" size={20} stroke={2} />
                  </span>
                  <span class="mk-voice__meta">
                    <span class="mk-voice__title">Outbound call</span>
                    <span class="mk-voice__sub">Appointment reminder · 0:24</span>
                  </span>
                  <span class="mk-voice__eq" aria-hidden="true">
                    {eqBars.map((h, i) => (
                      <span style={`height:${h}px;--eq:${i * 0.08}s`} />
                    ))}
                  </span>
                </div>
                <div class="mk-voice__ivr">
                  <span class="mk-voice__ivr-tag">IVR</span> · "Press 1 to confirm, 2 to
                  reschedule."
                </div>
                <div class="mk-voice__btns">
                  <span class="mk-voice__btn mk-voice__btn--primary">✓ Confirmed (1)</span>
                  <span class="mk-voice__btn">Reschedule (2)</span>
                </div>
              </div>
            )
          }
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------ METRICS */}
    <section class="ch-metrics">
      <div class="container--wide ch-metrics__grid">
        {
          data.stats.map((s) => (
            <div class="ch-stat" data-reveal style={`--reveal-delay:${s.delay}ms`}>
              <div
                class="ch-stat__num mono tnum"
                data-count
                data-to={s.to}
                data-suffix={s.suffix}
                data-decimals={s.decimals}
                data-prefix={s.prefix}
              >
                {s.prefix}0{s.suffix}
              </div>
              <div class="ch-stat__label">{s.label}</div>
            </div>
          ))
        }
      </div>
    </section>

    {/* -------------------------------------------------- IN THE WORKSPACE */}
    <section class="ch-shot container--wide">
      <p class="eyebrow" data-reveal>In the workspace</p>
      <h2 class="h-section ch-shot__title" data-reveal style="--reveal-delay:60ms">
        See {data.label} in action.
      </h2>

      <div class="ch-frame" data-reveal style="--reveal-delay:80ms">
        <div class="ch-frame__bar">
          <span class="mk__dot"></span><span class="mk__dot"></span><span class="mk__dot"></span>
          <span class="mono ch-frame__url">app.maildrill.com/{data.key}</span>
        </div>
        <div class="ch-frame__body">
          {/* Workspace app mock — recreated in CSS (no screenshot). */}
          <div class="ws">
            <aside class="ws__nav" aria-hidden="true">
              <div class="ws__brand">
                <span class="ws__logo">M</span>
                <span class="ws__brandname">Maildrill</span>
              </div>
              <div class="ws__navlist">
                <span class="ws__navitem">Dashboard</span>
                <span class="ws__navitem ws__navitem--active">Campaigns</span>
                <span class="ws__navitem">Templates</span>
                <span class="ws__navitem">Audience</span>
                <span class="ws__navitem">Analytics</span>
              </div>
            </aside>
            <div class="ws__main">
              <div class="ws__head">
                <div>
                  <div class="mono ws__eyebrow">Campaign · Spring Launch</div>
                  <div class="ws__title">{data.label} performance</div>
                </div>
                <div class="ws__actions">
                  <span class="ws__badge"
                    ><Icon name={data.icon} size={13} stroke={2} />{data.label}</span
                  >
                  <span class="ws__send">Send</span>
                </div>
              </div>
              <div class="ws__kpis">
                {
                  data.stats.map((s) => (
                    <div class="ws__kpi">
                      <span class="ws__kpi-label">{s.label}</span>
                      <b class="mono tnum ws__kpi-val">{fmt(s)}</b>
                    </div>
                  ))
                }
              </div>
              <div class="ws__chart" aria-hidden="true">
                <span style="height:38%;--d:.30s"></span>
                <span style="height:60%;--d:.38s"></span>
                <span style="height:47%;--d:.46s"></span>
                <span style="height:78%;--d:.54s"></span>
                <span style="height:64%;--d:.62s"></span>
                <span class="ws__chart-accent" style="height:94%;--d:.70s"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* --------------------------------------------------------- CAPABILITIES */}
    <section class="ch-features container--wide">
      <p class="eyebrow" data-reveal>Capabilities</p>
      <h2 class="h-section ch-features__title" data-reveal style="--reveal-delay:60ms">
        {data.featuresTitle}
      </h2>
      <div class="ch-features__grid">
        {
          data.features.map((f) => (
            <div class="ch-feat" data-reveal style={`--reveal-delay:${f.delay}ms`}>
              <span class="ch-feat__ic">
                {f.icon === 'wizard' ? (
                  <svg
                    class="icon"
                    viewBox="0 0 24 24"
                    width={22}
                    height={22}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={wizardPath}
                  />
                ) : (
                  <Icon name={f.icon as IconName} size={22} stroke={2} />
                )}
              </span>
              <h3 class="ch-feat__title">{f.title}</h3>
              <p class="ch-feat__desc">{f.desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    {/* ------------------------------------------------------------ USE CASES */}
    <section class="ch-uses">
      <div class="container--wide">
        <p class="eyebrow" data-reveal>Use cases</p>
        <h2 class="h-section ch-uses__title" data-reveal style="--reveal-delay:60ms">
          {data.useTitle}
        </h2>
        <div class="ch-uses__list">
          {
            data.useCases.map((u) => (
              <div class="ch-use" data-reveal style={`--reveal-delay:${u.delay}ms`}>
                <span class="mono ch-use__num">{u.num}</span>
                <span class="ch-use__title">{u.title}</span>
                <span class="ch-use__desc">{u.desc}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* -------------------------------------------------------- HOW IT WORKS */}
    <section class="ch-steps container--wide">
      <p class="eyebrow" data-reveal>How it works</p>
      <h2 class="h-section ch-steps__title" data-reveal style="--reveal-delay:60ms">
        Live in four steps.
      </h2>
      <div class="ch-steps__grid">
        {
          channelSteps.map((st) => (
            <div class="ch-step" data-reveal style={`--reveal-delay:${st.delay}ms`}>
              <div class="mono ch-step__n">{st.n}</div>
              <div class="ch-step__title">{st.title}</div>
              <div class="ch-step__desc">{st.desc}</div>
            </div>
          ))
        }
      </div>
    </section>

    {/* ----------------------------------------------------- OTHER CHANNELS */}
    <section class="ch-others container--wide">
      <p class="eyebrow" data-reveal>Other channels</p>
      <h2 class="ch-others__title" data-reveal style="--reveal-delay:60ms">
        One audience, every channel.
      </h2>
      <div class="ch-others__grid">
        {
          others.map((o, i) => (
            <a href={o.href} class="ch-other" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="ch-other__ic" style={`background:${o.tint};color:${o.color}`}>
                <Icon name={o.icon} size={22} stroke={2} />
              </span>
              <span class="ch-other__text">
                <span class="ch-other__label">{o.label}</span>
                <span class="ch-other__tag">{o.tag}</span>
              </span>
              <span class="ch-other__arrow" aria-hidden="true">
                <Icon name="arrow-up-right" size={20} stroke={2} />
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</MarketingLayout>

<style>
  .ch {
    /* Fallbacks in case a channel omits a var. */
    --cc: var(--accent);
    --ct: var(--accent-tint);
    --cg: rgba(79, 70, 229, 0.12);
    /* Contain the hero glow blob (positioned 30px past the container edge). */
    overflow-x: clip;
  }

  /* ============================================================= HERO */
  .ch-hero {
    position: relative;
    padding-block: 56px 40px;
  }

  .ch-hero__glow {
    position: absolute;
    top: 10px;
    right: -30px;
    width: 420px;
    height: 420px;
    max-width: 70vw;
    background: radial-gradient(circle at 40% 40%, var(--cg), transparent 62%);
    filter: blur(10px);
    border-radius: 60% 40% 55% 45% / 50% 55% 45% 50%;
    animation: blob 16s ease-in-out infinite;
    pointer-events: none;
  }

  .ch-back {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text4);
    text-decoration: none;
  }

  .ch-back:hover {
    color: var(--text2);
  }

  .ch-hero__grid {
    position: relative;
    display: grid;
    gap: 40px;
    align-items: center;
    margin-top: 24px;
  }

  .ch-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: var(--ct);
    color: var(--cc);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .ch-hero__title {
    font-size: clamp(2.625rem, 5.6vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--text);
    margin: 18px 0 0;
    max-width: 15ch;
  }

  .ch-hero__sub {
    font-size: var(--fs-lg);
    line-height: 1.55;
    color: var(--text3);
    margin: 22px 0 0;
    max-width: 52ch;
  }

  .ch-hero .cta-row {
    margin-top: 30px;
  }

  /* Ink pill → CHANNEL color on hover (the one channel-tinted CTA). */
  .ch-cta:hover {
    background: var(--cc);
    color: #fff;
  }

  .ch-hero__visual {
    justify-self: center;
    width: 100%;
    max-width: 440px;
  }

  @media (min-width: 900px) {
    .ch-hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 56px;
    }
    .ch-hero__visual {
      justify-self: end;
    }
  }

  /* ---- shared mock bits ---- */
  .mk__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #e4e2da;
    flex-shrink: 0;
  }

  .mk--float {
    animation: floaty 7.5s ease-in-out infinite;
  }

  /* ---- EMAIL mock ---- */
  .mk-email {
    background: #fbfaf8;
    border: 1px solid #ecebe6;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 22px 50px rgba(30, 27, 22, 0.1);
  }

  .mk-email__bar {
    height: 36px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    background: #fff;
    border-bottom: 1px solid #efeee9;
  }

  .mk-email__tab {
    margin-left: 8px;
    font-size: 12px;
    color: #77756c;
  }

  .mk-email__body {
    padding: 18px 20px;
    background: #fff;
  }

  .mk-email__from {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .mk-email__avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #eef0ff;
    color: #4f46e5;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
    flex-shrink: 0;
  }

  .mk-email__name {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #1f1e1b;
  }

  .mk-email__to {
    display: block;
    font-size: 11px;
    color: #a5a39a;
  }

  .mk-email__subject {
    font-size: 17px;
    font-weight: 600;
    color: #1f1e1b;
    margin-bottom: 12px;
  }

  .mk-email__hero {
    height: 130px;
    border-radius: 10px;
    background: linear-gradient(135deg, #eef0ff, #f6f5f2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #a5a3d6;
    font-size: 12px;
    font-weight: 500;
    margin-bottom: 14px;
  }

  .mk-email__line {
    height: 12px;
    border-radius: 5px;
    background: #efeee9;
    margin-bottom: 7px;
  }

  .mk-email__line + .mk-email__btn {
    margin-top: 9px;
  }

  .mk-email__btn {
    display: inline-block;
    padding: 10px 20px;
    border-radius: 8px;
    background: #4f46e5;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
  }

  /* ---- SMS mock ---- */
  .mk-sms {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px;
    background: #f0fdff;
    border: 1px solid #cff2f7;
    border-radius: 16px;
    box-shadow: 0 22px 50px rgba(30, 27, 22, 0.08);
  }

  .mk-sms__bubble {
    max-width: 80%;
    font-size: 14px;
    line-height: 1.5;
    padding: 12px 15px;
    animation: pop 0.5s ease var(--pop, 0s) both;
  }

  .mk-sms__bubble--in {
    align-self: flex-start;
    background: #fff;
    border: 1px solid #e0f2f5;
    border-radius: 14px 14px 14px 4px;
    color: #1f1e1b;
  }

  .mk-sms__bubble--out {
    align-self: flex-end;
    background: #0891b2;
    color: #fff;
    border-radius: 14px 14px 4px 14px;
  }

  /* ---- WhatsApp mock ---- */
  .mk-wa {
    padding: 24px;
    background: #e8f6ec;
    border: 1px solid #cdeed6;
    border-radius: 16px;
    box-shadow: 0 22px 50px rgba(30, 27, 22, 0.08);
  }

  .mk-wa__head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .mk-wa__avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #16a34a;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
    flex-shrink: 0;
  }

  .mk-wa__name {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #1f1e1b;
  }

  .mk-wa__status {
    display: block;
    font-size: 11px;
    color: #16a34a;
  }

  .mk-wa__card {
    background: #fff;
    border-radius: 12px;
    padding: 14px;
    animation: pop 0.5s ease both;
  }

  .mk-wa__preview {
    height: 96px;
    border-radius: 8px;
    background: linear-gradient(135deg, #dcfce7, #f0fdf4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #86c79b;
    font-size: 12px;
    margin-bottom: 10px;
  }

  .mk-wa__title {
    font-size: 13px;
    font-weight: 600;
    color: #1f1e1b;
    margin-bottom: 4px;
  }

  .mk-wa__body {
    font-size: 12px;
    color: #57554e;
    line-height: 1.5;
    margin-bottom: 12px;
  }

  .mk-wa__btns {
    display: flex;
    gap: 8px;
  }

  .mk-wa__btn {
    flex: 1;
    text-align: center;
    padding: 9px;
    border-radius: 8px;
    background: #f3f2ee;
    color: #3a3833;
    font-size: 12px;
    font-weight: 600;
  }

  .mk-wa__btn--primary {
    background: #dcfce7;
    color: #16a34a;
  }

  /* ---- Voice mock ---- */
  .mk-voice {
    padding: 26px;
    background: #fffbeb;
    border: 1px solid #fdeec3;
    border-radius: 16px;
    box-shadow: 0 22px 50px rgba(30, 27, 22, 0.08);
  }

  .mk-voice__row {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    border: 1px solid #fdeec3;
    border-radius: 14px;
    padding: 15px 16px;
    margin-bottom: 14px;
    animation: pop 0.5s ease both;
  }

  .mk-voice__ic {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fef3c7;
    color: #d97706;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .mk-voice__meta {
    flex: 1;
  }

  .mk-voice__title {
    display: block;
    font-size: 14px;
    font-weight: 600;
