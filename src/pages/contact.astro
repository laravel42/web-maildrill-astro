---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import ContactForm from '@/components/react/ContactForm';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/lib/icons';
import { breadcrumbJsonLd, organizationJsonLd } from '@/lib/seo/structured-data';
import { routes } from '@/config/routes';

const seo = {
  title: 'Contact — Talk to the Maildrill team',
  description:
    'Get in touch with Maildrill. Talk to sales about volume and custom plans, reach support, or ask about deliverability, SMS, and WhatsApp campaigns.',
};

type Channel = {
  icon: IconName;
  title: string;
  desc: string;
  link: string;
  href: string;
  color: string;
  tint: string;
};

const channels: Channel[] = [
  {
    icon: 'bolt',
    title: 'Sales',
    desc: 'Volume pricing, custom plans, and demos for teams.',
    link: 'sales@maildrill.net',
    href: 'mailto:sales@maildrill.net',
    color: 'var(--ch-email)',
    tint: 'var(--ch-email-tint)',
  },
  {
    icon: 'shield',
    title: 'Support',
    desc: 'Already a customer? Reach our support team.',
    link: 'support@maildrill.net',
    href: 'mailto:support@maildrill.net',
    color: 'var(--ch-whatsapp)',
    tint: 'var(--ch-whatsapp-tint)',
  },
  {
    icon: 'globe',
    title: 'General',
    desc: 'Partnerships, press, and everything else.',
    link: 'hello@maildrill.net',
    href: 'mailto:hello@maildrill.net',
    color: 'var(--ch-sms)',
    tint: 'var(--ch-sms-tint)',
  },
];

const jsonLd = [
  organizationJsonLd(),
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Contact', path: routes.contact },
  ]),
];
---

<MarketingLayout seo={seo} jsonLd={jsonLd} active="contact">
  <section class="contact container--wide">
    <div class="contact__grid">
      <div class="contact__left">
        <p class="eyebrow" data-reveal>Contact</p>
        <h1 class="contact__title display" data-reveal style="--reveal-delay:60ms">Let's talk</h1>
        <p class="contact__lead" data-reveal style="--reveal-delay:120ms">
          Whether you're evaluating Maildrill, scaling past a million messages, or need a hand —
          we're quick to respond.
        </p>
        <div class="contact__channels">
          {
            channels.map((c, i) => (
              <div
                class="contact__channel"
                data-card
                data-reveal
                style={`--reveal-delay:${i * 80}ms`}
              >
                <span class="contact__ic" style={`background:${c.tint};color:${c.color}`}>
                  <Icon name={c.icon} size={20} />
                </span>
                <div>
                  <div class="contact__ctitle">{c.title}</div>
                  <p class="contact__cdesc">{c.desc}</p>
                  <a href={c.href} class="contact__clink">
                    {c.link}
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="contact__formwrap" data-card data-reveal style="--reveal-delay:120ms">
        <ContactForm client:load />
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .contact {
    padding-block: 72px 40px;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 56px;
    align-items: start;
  }

  .contact__title {
    font-size: clamp(2.75rem, 5.5vw, 5rem);
    margin: 14px 0 0;
  }

  .contact__lead {
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--text3);
    margin: 16px 0 32px;
  }

  .contact__channels {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact__channel {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px 20px;
    transition:
      border-color var(--duration) var(--ease-out),
      box-shadow var(--duration) var(--ease-out);
  }

  .contact__channel:hover {
    border-color: var(--border2);
    box-shadow: var(--shadow-md);
  }

  .contact__ic {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact__ctitle {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 3px;
  }

  .contact__cdesc {
    font-size: 14px;
    line-height: 1.5;
    color: var(--text3);
    margin: 0 0 2px;
  }

  .contact__clink {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }

  .contact__formwrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 36px;
    box-shadow: 0 12px 34px rgba(30, 27, 22, 0.06);
  }

  @media (max-width: 860px) {
    .contact__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 520px) {
    .contact__formwrap {
      padding: 24px;
    }
  }
</style>
