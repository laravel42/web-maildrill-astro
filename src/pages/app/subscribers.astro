---
export const prerender = false;
import AppLayout from '@/layouts/AppLayout.astro';
import AppSubscribers from '@/components/react/AppSubscribers';
import { productClient } from '@/lib/server/service';
import { toRichSubscribers, type ApiSubscriber } from '@/lib/app/subscriber-map';
import type { RichSubscriber } from '@/lib/app/subscribers-data';

// Load real subscribers for the signed-in workspace from maildrill-service and
// hand them to the island. Falls back to local fixtures if the service is
// unreachable or the workspace has none yet.
const session = Astro.locals.session;
// undefined = not connected (island uses fixtures); an array = live data (even if empty).
let initial: RichSubscriber[] | undefined = undefined;
let banner: { ok: boolean; text: string } | null = null;

if (session?.user?.id && session.activeTenantId) {
  try {
    const client = productClient({
      userId: session.user.id,
      activeTenantId: session.activeTenantId,
      role: session.role,
    });
    const { data, error } = await client.GET('/v1/subscribers', {
      params: { query: { limit: 200 } },
    });
    if (error) {
      banner = { ok: false, text: 'maildrill-service returned an error.' };
    } else {
      const rows = (data as unknown as { data?: ApiSubscriber[] })?.data ?? [];
      initial = toRichSubscribers(rows);
      banner = { ok: true, text: `Live from maildrill-service — ${initial.length} subscriber(s).` };
    }
  } catch (err) {
    banner = { ok: false, text: err instanceof Error ? err.message : 'Service unreachable.' };
  }
}
---

<AppLayout title="Subscribers">
  {banner && <div class={`svc-banner ${banner.ok ? 'ok' : 'err'}`}>{banner.text}</div>}
  <AppSubscribers client:visible initial={initial} />
</AppLayout>

<style>
  .svc-banner {
    margin: 0 0 14px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12.5px;
  }
  .svc-banner.ok {
    border: 1px solid #16a34a;
    background: #f0fdf4;
    color: #166534;
  }
  .svc-banner.err {
    border: 1px solid #dc2626;
    background: #fef2f2;
    color: #991b1b;
  }
</style>
