---
export const prerender = false;
import AppLayout from '@/layouts/AppLayout.astro';
import AppMedia from '@/components/react/AppMedia';
import { productClient } from '@/lib/server/service';
import { toMediaFiles, type ApiMediaAsset } from '@/lib/app/media-map';

// Live assets plus whether storage is configured at all — the island disables
// uploading and says so rather than failing on the first file.
const session = Astro.locals.session;
let initial: ReturnType<typeof toMediaFiles> | undefined = undefined;
let storageReady = false;
let banner: { ok: boolean; text: string } | null = null;

if (session?.user?.id && session.activeTenantId) {
  try {
    const client = productClient({
      userId: session.user.id,
      activeTenantId: session.activeTenantId,
      role: session.role,
    });
    const [listRes, statusRes] = await Promise.all([
      client.GET('/v1/media'),
      client.GET('/v1/media/status'),
    ]);
    if (listRes.error) {
      banner = { ok: false, text: 'maildrill-service returned an error.' };
    } else {
      initial = toMediaFiles((listRes.data as unknown as { data?: ApiMediaAsset[] })?.data ?? []);
      storageReady = Boolean(
        (statusRes.data as unknown as { configured?: boolean })?.configured,
      );
      banner = storageReady
        ? null
        : {
            ok: false,
            text: 'Media storage is not configured. Set AWS_REGION, MEDIA_S3_BUCKET and MEDIA_CDN_DOMAIN in maildrill-service to enable uploads.',
          };
    }
  } catch (err) {
    banner = { ok: false, text: err instanceof Error ? err.message : 'Service unreachable.' };
  }
}
---

<AppLayout title="Media Library">
  {banner && <div class={`svc-banner ${banner.ok ? 'ok' : 'err'}`}>{banner.text}</div>}
  <AppMedia client:visible initial={initial} storageReady={storageReady} />
</AppLayout>

<style>
  .svc-banner {
    margin: 0 0 14px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12.5px;
  }
  .svc-banner.ok {
    border: 1px solid #16a34a;
    background: #f0fdf4;
    color: #166534;
  }
  .svc-banner.err {
    border: 1px solid #dc2626;
    background: #fef2f2;
    color: #991b1b;
  }
</style>
