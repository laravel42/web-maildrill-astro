---
export const prerender = false;
import AppLayout from '@/layouts/AppLayout.astro';
import AppAnalytics from '@/components/react/AppAnalytics';
import { productClient } from '@/lib/server/service';
import type { ActivityPoint, ChannelBreakdown } from '@/components/react/AppAnalytics.logic';

// Send activity for the default 30-day window, plus the per-channel split. The
// island refetches when the range or channel changes.
const session = Astro.locals.session;
let initialDaily: ActivityPoint[] = [];
let byChannel: ChannelBreakdown[] = [];
let live = false;
let banner: { ok: boolean; text: string } | null = null;

if (session?.user?.id && session.activeTenantId) {
  try {
    const client = productClient({
      userId: session.user.id,
      activeTenantId: session.activeTenantId,
      role: session.role,
    });
    const [activityRes, summaryRes] = await Promise.all([
      client.GET('/v1/stats/activity', { params: { query: { days: 30 } } }),
      client.GET('/v1/stats/summary'),
    ]);
    if (activityRes.error) {
      banner = { ok: false, text: 'maildrill-service returned an error.' };
    } else {
      initialDaily = (activityRes.data as unknown as { data?: ActivityPoint[] })?.data ?? [];
      byChannel =
        (summaryRes.data as unknown as { byChannel?: ChannelBreakdown[] })?.byChannel ?? [];
      live = true;
    }
  } catch (err) {
    banner = { ok: false, text: err instanceof Error ? err.message : 'Service unreachable.' };
  }
}
---

<AppLayout title="Analytics">
  {banner && <div class={`svc-banner ${banner.ok ? 'ok' : 'err'}`}>{banner.text}</div>}
  <AppAnalytics client:visible initialDaily={initialDaily} byChannel={byChannel} live={live} />
</AppLayout>

<style>
  .svc-banner {
    margin: 0 0 14px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12.5px;
  }
  .svc-banner.ok {
    border: 1px solid #16a34a;
    background: #f0fdf4;
    color: #166534;
  }
  .svc-banner.err {
    border: 1px solid #dc2626;
    background: #fef2f2;
    color: #991b1b;
  }
</style>
