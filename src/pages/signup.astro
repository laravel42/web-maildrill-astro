---
import AuthLayout from '@/layouts/AuthLayout.astro';
import AuthForm from '@/components/react/AuthForm';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/lib/icons';

const seo = {
  title: 'Start free trial',
  description:
    'Create your Maildrill account and start sending across email, SMS, WhatsApp, and voice. No credit card required.',
  noindex: true,
};

// What the free trial includes — matches the sign-up design's panel.
const perks: { icon: IconName; t: string }[] = [
  { icon: 'bolt', t: '100 emails included' },
  { icon: 'chart', t: '15 SMS messages' },
  { icon: 'code', t: '100 WhatsApp messages' },
  { icon: 'shield', t: '60 min of voice calls' },
];
---

<AuthLayout
  seo={seo}
  panelEyebrow="Get started free"
  panelHeading={'Launch your first <span style="color:#ff441f">campaign</span> in minutes.'}
  panelGlowSwap
>
  <AuthForm client:load mode="signup" />

  <div slot="panel" class="spanel">
    <span class="spanel__badge mono">Free trial</span>
    <ul class="spanel__perks">
      {
        perks.map((p) => (
          <li>
            <span class="spanel__ic">
              <Icon name={p.icon} size={16} />
            </span>
            {p.t}
          </li>
        ))
      }
    </ul>
  </div>
</AuthLayout>

<style is:global>
  .spanel {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .spanel__badge {
    align-self: flex-start;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ff8f79;
    background: rgba(255, 68, 31, 0.12);
    border: 1px solid rgba(255, 143, 121, 0.3);
    padding: 5px 11px;
    border-radius: 999px;
  }
  .spanel__perks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .spanel__perks li {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .spanel__ic {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #ff8f79;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
