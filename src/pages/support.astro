---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/lib/icons';
import { routes } from '@/config/routes';
import { externalUrls } from '@/config/site';
import { breadcrumbJsonLd } from '@/lib/seo/structured-data';

const seo = {
  title: 'Support — Maildrill help center',
  description:
    'Get help with Maildrill: browse help topics on getting started, deliverability, channels, billing, and the API, find popular answers, or reach our support team.',
};

const jsonLd = breadcrumbJsonLd([
  { name: 'Home', path: routes.home },
  { name: 'Support', path: routes.support },
]);

type Category = {
  icon: IconName;
  title: string;
  desc: string;
  count: string;
  color: string;
  tint: string;
  href: string;
  delay: number;
};

const categories: Category[] = [
  {
    icon: 'bolt',
    title: 'Getting started',
    desc: 'Create your workspace, invite your team, and send your first campaign.',
    count: '14',
    color: 'var(--accent)',
    tint: 'var(--accent-tint)',
    href: routes.guides,
    delay: 0,
  },
  {
    icon: 'shield',
    title: 'Deliverability',
    desc: 'Domain authentication, warmup, and keeping messages out of spam.',
    count: '22',
    color: 'var(--success)',
    tint: 'var(--success-bg)',
    href: routes.deliverability,
    delay: 80,
  },
  {
    icon: 'layers',
    title: 'Channels',
    desc: 'Set up and send across email, SMS, WhatsApp, and voice.',
    count: '31',
    color: 'var(--ch-sms)',
    tint: 'var(--ch-sms-tint)',
    href: `${routes.product}#channels`,
    delay: 160,
  },
  {
    icon: 'chart',
    title: 'Analytics',
    desc: 'Read reports, build funnels, and compare campaign performance.',
    count: '12',
    color: 'var(--warning)',
    tint: 'var(--warning-bg)',
    href: routes.product,
    delay: 0,
  },
  {
    icon: 'filter',
    title: 'Billing & account',
    desc: 'Pay-per-use billing, prepay tiers, invoices, and account settings.',
    count: '9',
    color: 'var(--success)',
    tint: 'var(--success-bg)',
    href: routes.pricing,
    delay: 160,
  },
];

type Article = { title: string; icon: IconName; color: string; tint: string; href: string };

const popular: Article[] = [
  {
    title: 'How do I authenticate my sending domain?',
    icon: 'shield',
    color: 'var(--success)',
    tint: 'var(--success-bg)',
    href: '/guides/domain-authentication',
  },
  {
    title: 'What counts as one billable message per channel?',
    icon: 'filter',
    color: 'var(--accent)',
    tint: 'var(--accent-tint)',
    href: routes.pricing,
  },
  {
    title: 'How do annual prepay discounts work?',
    icon: 'filter',
    color: 'var(--success)',
    tint: 'var(--success-bg)',
    href: routes.pricing,
  },
  {
    title: 'How do I warm up a new sending domain?',
    icon: 'bolt',
    color: 'var(--accent)',
    tint: 'var(--accent-tint)',
    href: routes.guides,
  },
  {
    title: 'Getting WhatsApp templates approved',
    icon: 'layers',
    color: 'var(--success)',
    tint: 'var(--success-bg)',
    href: routes.channels.whatsapp,
  },
];

type Contact = {
  icon: IconName;
  title: string;
  desc: string;
  color: string;
  tint: string;
  href: string;
  delay: number;
};

const contacts: Contact[] = [
  {
    icon: 'mail',
    title: 'Email support',
    desc: 'Reach our team at support@maildrill.net — we reply within one business day.',
    color: 'var(--accent)',
    tint: 'var(--accent-tint)',
    href: 'mailto:support@maildrill.net',
    delay: 0,
  },
  {
    icon: 'users',
    title: 'Talk to a human',
    desc: 'Book a call or message sales about your setup and volume.',
    color: 'var(--ch-sms)',
    tint: 'var(--ch-sms-tint)',
    href: routes.contact,
    delay: 80,
  },
  {
    icon: 'globe',
    title: 'System status',
    desc: 'All systems operational. Subscribe for incident updates.',
    color: 'var(--success)',
    tint: 'var(--success-bg)',
    href: externalUrls.status,
    delay: 160,
  },
];
---

<MarketingLayout seo={seo} jsonLd={jsonLd} active="resources">
  {/* ---------------------------------------------------------------- HERO */}
  <section class="sup-hero">
    <div class="sup-hero__glow sup-hero__glow--indigo" aria-hidden="true"></div>
    <div class="sup-hero__glow sup-hero__glow--orange" aria-hidden="true"></div>
    <div class="sup-hero__inner">
      <p class="eyebrow sup-hero__eyebrow" data-reveal>Support</p>
      <h1 class="display sup-hero__title" data-reveal style="--reveal-delay:80ms">
        How can we help?
      </h1>

      <form
        class="sup-search"
        action={routes.guides}
        method="get"
        role="search"
        data-reveal
        style="--reveal-delay:140ms"
      >
        <label class="sr-only" for="support-search">Search help articles</label>
        <span class="sup-search__icon" aria-hidden="true">
          <Icon name="search" size={20} stroke={2} />
        </span>
        <input
          class="sup-search__input"
          id="support-search"
          type="search"
          name="q"
          placeholder="Search help articles…"
          autocomplete="off"
        />
        <button class="sup-search__btn" type="submit">Search</button>
      </form>

      <p class="sup-hero__popular" data-reveal style="--reveal-delay:200ms">
        Popular:
        <a href="/guides/domain-authentication">domain setup</a> ·
        <a href={routes.pricing}>billing</a>
      </p>
    </div>
  </section>

  {/* ---------------------------------------------------------- CATEGORIES */}
  <section class="sup-cats container--wide">
    <p class="eyebrow" data-reveal>Browse topics</p>
    <h2 class="h-section sup-cats__title" data-reveal style="--reveal-delay:60ms">
      Find your way around.
    </h2>
    <div class="sup-cats__grid">
      {
        categories.map((c) => (
          <a class="cat" href={c.href} data-reveal style={`--reveal-delay:${c.delay}ms`}>
            <div class="cat__top">
              <span class="cat__ic" style={`background:${c.tint};color:${c.color}`}>
                <Icon name={c.icon} size={22} />
              </span>
              <span class="cat__arrow" aria-hidden="true">
                <Icon name="arrow-up-right" size={18} stroke={2} />
              </span>
            </div>
            <h3 class="cat__title">{c.title}</h3>
            <p class="cat__desc">{c.desc}</p>
            <span class="mono cat__count">{c.count} articles</span>
          </a>
        ))
      }
    </div>
  </section>

  {/* ------------------------------------------------- POPULAR + CONTACT */}
  <section class="sup-help container--wide">
    <div class="sup-help__main">
      <p class="eyebrow" data-reveal>Popular articles</p>
      <div class="pop" data-reveal style="--reveal-delay:60ms">
        {
          popular.map((a) => (
            <a class="pop__row" href={a.href}>
              <span
                class="pop__ic"
                style={`background:${a.tint};color:${a.color}`}
                aria-hidden="true"
              >
                <Icon name={a.icon} size={16} />
              </span>
              <span class="pop__title">{a.title}</span>
              <span class="pop__arrow" aria-hidden="true">
                <Icon name="arrow-right" size={16} stroke={2} />
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <aside class="sup-help__aside">
      <p class="eyebrow" data-reveal>Still stuck?</p>
      <div class="sup-help__contacts">
        {
          contacts.map((c) => (
            <a class="contact" href={c.href} data-reveal style={`--reveal-delay:${c.delay}ms`}>
              <span
                class="contact__ic"
                style={`background:${c.tint};color:${c.color}`}
                aria-hidden="true"
              >
                <Icon name={c.icon} size={19} />
              </span>
              <span class="contact__body">
                <span class="contact__title">{c.title}</span>
                <span class="contact__desc">{c.desc}</span>
              </span>
            </a>
          ))
        }
      </div>
    </aside>
  </section>
</MarketingLayout>

<style>
  /* ------------------------------------------------------------- HERO */
  .sup-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--ink-band2), var(--ink-band));
  }

  .sup-hero__glow {
    position: absolute;
    pointer-events: none;
  }

  .sup-hero__glow--indigo {
    top: -80px;
    right: 8%;
    width: 360px;
    height: 360px;
    max-width: 70vw;
    background: radial-gradient(circle, rgba(99, 91, 245, 0.26), transparent 65%);
    animation: blob 14s ease-in-out infinite;
  }

  .sup-hero__glow--orange {
    bottom: -100px;
    left: 4%;
    width: 340px;
    height: 340px;
    max-width: 70vw;
    background: radial-gradient(circle, rgba(255, 68, 31, 0.2), transparent 65%);
    animation: drift 12s ease-in-out infinite;
  }

  .sup-hero__inner {
    position: relative;
    max-width: 820px;
    margin-inline: auto;
    padding: calc(72px * var(--sec-y)) var(--gutter) calc(64px * var(--sec-y));
    text-align: center;
  }

  .sup-hero__eyebrow {
    color: var(--muted);
  }

  .sup-hero__title {
    font-size: clamp(2.5rem, 5.6vw, 5rem);
    line-height: 1;
    color: var(--ink-band-text);
    margin: 16px 0 0;
  }

  /* ---- Search ---- */
  .sup-search {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 560px;
    margin: 28px auto 0;
    background: var(--surface);
    border-radius: 14px;
    padding: 8px 8px 8px 18px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
  }

  .sup-search__icon {
    display: inline-flex;
    color: var(--muted);
    flex-shrink: 0;
  }

  .sup-search__input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    font-family: inherit;
    font-size: 16px;
    color: var(--text);
  }

  .sup-search__input::placeholder {
    color: var(--muted);
  }

  .sup-search__btn {
    padding: 11px 20px;
    border: none;
    border-radius: 10px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    transition: background var(--duration) var(--ease-out);
  }

  .sup-search__btn:hover {
    background: var(--accent-hover);
  }

  .sup-hero__popular {
    font-size: 13px;
    color: var(--muted);
    margin: 16px 0 0;
  }

  .sup-hero__popular a {
    color: var(--ink-band-text2);
  }

  .sup-hero__popular a:hover {
    color: var(--ink-band-text);
  }

  /* ------------------------------------------------------- CATEGORIES */
  .sup-cats {
    padding-block: calc(64px * var(--sec-y)) calc(32px * var(--sec-y));
  }

  .sup-cats__title {
    margin: 14px 0 32px;
  }

  .sup-cats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .cat {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 26px;
    color: inherit;
    transition:
      border-color var(--duration) var(--ease-out),
      box-shadow var(--duration) var(--ease-out),
      transform var(--duration) var(--ease-out);
  }

  .cat:hover {
    border-color: var(--border2);
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }

  .cat__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .cat__ic {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    flex-shrink: 0;
  }

  .cat__arrow {
    display: inline-flex;
    color: var(--text);
    opacity: 0.3;
    transition:
      opacity var(--duration-slow) var(--ease-out),
      transform var(--duration-slow) var(--ease-out);
  }

  .cat:hover .cat__arrow {
    opacity: 1;
    transform: translate(4px, -4px);
  }

  .cat__title {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 6px;
  }

  .cat__desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--text3);
    margin: 0 0 12px;
    flex: 1;
  }

  .cat__count {
    font-size: 12px;
    color: var(--muted);
  }

  /* -------------------------------------------------- POPULAR + CONTACT */
  .sup-help {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
    align-items: start;
    padding-block: calc(40px * var(--sec-y)) calc(40px * var(--sec-y));
  }

  .pop {
    margin-top: 20px;
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface);
  }

  .pop__row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    border-top: 1px solid var(--divider);
    color: inherit;
    transition: background var(--duration-fast) var(--ease-out);
  }

  .pop__row:first-child {
    border-top: none;
  }

  .pop__row:hover {
    background: var(--surface3);
  }

  .pop__ic {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .pop__title {
    flex: 1;
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
  }

  .pop__arrow {
    display: inline-flex;
    color: var(--muted);
    opacity: 0.4;
    transition:
      opacity var(--duration-slow) var(--ease-out),
      transform var(--duration-slow) var(--ease-out);
  }

  .pop__row:hover .pop__arrow {
    opacity: 1;
    transform: translateX(4px);
  }

  .sup-help__contacts {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 20px;
  }

  .contact {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px 20px;
    color: inherit;
    transition:
      border-color var(--duration) var(--ease-out),
      box-shadow var(--duration) var(--ease-out);
  }

  .contact:hover {
    border-color: var(--border2);
    box-shadow: var(--shadow-sm);
  }

  .contact__ic {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    flex-shrink: 0;
  }

  .contact__title {
    display: block;
    font-size: 15px;
    font-weight: 600;
  }

  .contact__desc {
    display: block;
    font-size: 13px;
    line-height: 1.45;
    color: var(--text3);
    margin-top: 2px;
  }

  /* -------------------------------------------------------- RESPONSIVE */
  @media (max-width: 900px) {
    .sup-cats__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .sup-help {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 560px) {
    .sup-cats__grid {
      grid-template-columns: 1fr;
    }
    .sup-hero__inner {
      padding-top: calc(56px * var(--sec-y));
      padding-bottom: calc(52px * var(--sec-y));
    }
  }
</style>
