{
  "openapi": "3.0.3",
  "info": {
    "title": "Maildrill Product API",
    "version": "0.1.0",
    "description": "Subscribers, lists, segments, tags, templates, suppressions, auth, and campaign send. Auth: x-api-key or Bearer JWT."
  },
  "components": {
    "securitySchemes": {
      "apiKey": { "type": "apiKey", "in": "header", "name": "x-api-key" },
      "bearer": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {}
  },
  "paths": {
    "/health/live": { "get": { "responses": { "200": { "description": "Default Response" } } } },
    "/health/ready": { "get": { "responses": { "200": { "description": "Default Response" } } } },
    "/v1/auth/code/request": {
      "post": {
        "summary": "Email a 6-digit sign-in code (+ auto-login link)",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "email": { "type": "string", "format": "email" } },
                "required": ["email"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": { "200": { "description": "Default Response" } }
      }
    },
    "/v1/auth/code/verify": {
      "post": {
        "summary": "Verify a login code, returning identity + workspaces",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "code": { "type": "string", "minLength": 4, "maxLength": 8 }
                },
                "required": ["email", "code"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": { "200": { "description": "Default Response" } }
      }
    },
